{
  "schemaVersion": 1,
  "reconciliation": {
    "deleteUnknownChannels": true,
    "deleteUnknownCategories": true
  },
  "server": {
    "name": "SNEStorage",
    "description": "A community for SNES hacking, homebrew, documentation, tools, graphics, music, and creator resources.",
    "preferredLocale": "en-US",
    "iconPath": "../Logo/icono.png",
    "communityEnabled": true,
    "discoveryEnabled": false,
    "defaultMessageNotifications": "ONLY_MENTIONS",
    "explicitContentFilter": "ALL_MEMBERS",
    "verificationLevel": "HIGH",
    "afkTimeoutSeconds": 300
  },
  "accessGate": {
    "mode": "SNESTORAGE_ACCOUNT_ONLY",
    "publicInvitesEnabled": false,
    "joinPath": "/Community/Discord/Join",
    "oauthCallbackPath": "/api/discord/oauth/callback",
    "discordOauthScopes": [
      "identify",
      "guilds.join"
    ],
    "requirements": {
      "authenticatedSNEStorageAccount": true,
      "confirmedEmail": true,
      "activeAccount": true,
      "notBanned": true,
      "turnstileProtectedRegistration": true
    },
    "accountLinking": {
      "oneDiscordAccountPerSNEStorageAccount": true,
      "oneSNEStorageAccountPerDiscordAccount": true,
      "storeDiscordUserId": true,
      "storeOauthAccessToken": false,
      "assignRole": "member"
    },
    "onSNEStorageBan": "REMOVE_FROM_SERVER",
    "onAccountUnlink": "REMOVE_MEMBER_ROLE"
  },
  "bot": {
    "roleManagedByDiscord": true,
    "roleName": "SNEStorage Bot",
