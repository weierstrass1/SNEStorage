@page "/Error"
@page "/Error/{Code:int}"

<PageTitle>Error @_displayCode | SNEStorage</PageTitle>

<section class="w errp">
    <p class="code">@_displayCode</p>
    <h1>@_title</h1>
    <p>@_description</p>
    <div class="hero-actions">
        <a class="btn y" href="/">Back to home</a>
        <a class="btn" href="/Resource">Browse resources</a>
    </div>
</section>

@code {
    [Parameter] public int? Code { get; set; }

    private int _displayCode;
    private string _title = string.Empty;
    private string _description = string.Empty;

    protected override void OnParametersSet()
    {
        _displayCode = Code ?? 500;
        (_title, _description) = _displayCode switch
        {
            401 => ("Sign in to continue", "You need an active account to access this section."),
            403 => ("You do not have permission to access this page", "Your account does not have access to this content."),
            404 => ("Page not found", "The link may have changed or the page may no longer exist."),
            503 => ("The vault is temporarily unavailable", "Please try again in a moment."),
            _ => ("Signal lost", "We could not complete your request. Please try again later.")
        };
    }
}
