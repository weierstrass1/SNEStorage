@page "/Community"
@using SNEStorage.Components.Community
@inherits StaticDocumentPage<CommunityDocument>

<PageTitle>@(_document?.Title ?? "Community") | SNEStorage</PageTitle>

<div class="community-page">
    <header class="community-heading">
        <p class="community-kicker">@(_document?.Kicker ?? "SNESTORAGE COMMUNITY")</p>
        <h1>@(_document?.Title ?? "Community")</h1>
        @if (_document is { } document)
        {
            <p class="community-introduction">@document.Introduction</p>
        }
    </header>

    @if (_loading)
    {
        <div class="community-status" role="status">Loading community information…</div>
    }
    else if (_error is not null)
    {
        <div class="community-status" role="alert"><p>@_error</p><button type="button" @onclick="LoadAsync">Try again</button></div>
    }
    else if (_document is { } community)
    {
        <div class="discord-servers">
            @foreach (var server in community.Servers)
            {
                <section class="discord-panel @(server.Primary ? "discord-panel-primary" : "discord-panel-secondary")" aria-label="@server.Name">
                    <div class="discord-art" aria-hidden="true">
                        <img class="discord-server-logo" src="@server.LogoUrl" alt="" loading="lazy" />
                    </div>
                    <div class="discord-copy">
                        <p class="discord-server-label">@server.Label</p>
                        <h2>@server.Name</h2>
                        <p>@server.Description</p>
                        @if (server.SafeDiscordUrl is { } invite)
                        {
                            <a class="discord-button" href="@invite" target="_blank" rel="noopener noreferrer">@server.JoinLabel <span aria-hidden="true">↗</span></a>
                            <small class="discord-link-note">@community.LinkNote</small>
                        }
                        else
                        {
                            <p class="discord-unavailable">@community.UnavailableText</p>
                        }
                    </div>
                </section>
            }
        </div>

        @if (community.ConnectionGuides.Count > 0)
        {
            <section class="community-connection" aria-labelledby="community-connection-title">
                <h2 id="community-connection-title">@community.ConnectionTitle</h2>
                <p class="connection-introduction">@community.ConnectionIntroduction</p>
                <div class="connection-grid">
                    @foreach (var guide in community.ConnectionGuides)
                    {
                        <article class="connection-card">
                            <h3>@guide.Title</h3>
                            <ol class="connection-steps">
                                @foreach (var step in guide.Steps)
                                {
                                    <li>
                                        <p>@step.Text</p>
                                        @if (step.SafeLinkUrl is { } link && !string.IsNullOrWhiteSpace(step.LinkLabel))
                                        {
                                            <a class="connection-step-link" href="@link"
                                               target="@(link.StartsWith('/') ? null : "_blank")"
                                               rel="@(link.StartsWith('/') ? null : "noopener noreferrer")">
                                                @step.LinkLabel <ActionArrow />
                                            </a>
                                        }
                                    </li>
                                }
                            </ol>
                        </article>
                    }
                </div>
            </section>
        }

        <section class="community-topics" aria-labelledby="community-topics-title">
            <h2 id="community-topics-title">@community.SectionsTitle</h2>
            <div class="topic-grid">
                @foreach (var section in community.Sections)
                {
                    <article class="topic-card"><span class="topic-pixel" aria-hidden="true"></span><h3>@section.Title</h3><p>@section.Text</p></article>
                }
            </div>
        </section>
        <aside class="community-guidelines">
            <p>@community.GuidelinesText</p>
            <a href="/Rules">@community.GuidelinesLinkLabel <span aria-hidden="true">→</span></a>
        </aside>
    }
</div>
