@page "/"
@inject SnestorageContext Context
@inject ResourceAccessService Access
@inject EditableContentService Content
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>SNEStorage | Resources for SNES</PageTitle>

<section class="hero home-hero">
    <span class="sp s1" aria-hidden="true">✦</span>
    <span class="sp s2" aria-hidden="true">✦</span>
    <span class="sp s3" aria-hidden="true">✦</span>
    <img class="hero-logo" src="images/logo-full.png" alt="Mario presents the SNEStorage box" />
    <h1>SNEStorage</h1>
    <p class="hero-copy">@_landingText</p>
    <div class="hero-actions">
        <a class="btn y" href="/Resource">Browse resources</a>
        <AuthorizeView>
            <NotAuthorized><a class="btn" href="/Register">Create account</a></NotAuthorized>
            <Authorized>
                @if (Access.CanUpload(context.User))
                {
                    <a class="btn" href="/Resources/Create">Upload a resource</a>
                }
            </Authorized>
        </AuthorizeView>
    </div>
</section>

<section class="find">
    <div class="w home-search">
        <h2>Find a resource</h2>
        <form method="get" action="/Resource" class="search-form">
            <label class="visually-hidden" for="home-search">Search resources</label>
            <input id="home-search" type="search" name="q" placeholder="Search patches, tools, music…" />
            <button class="y" type="submit">Search</button>
        </form>
    </div>
</section>

<section class="list latest-list">
    <div class="section-heading">
        <div>
            <p class="eyebrow">JUST ARRIVED</p>
            <h2>Latest resources</h2>
        </div>
        <a class="btn sm" href="/Resource">View full library →</a>
    </div>

    @if (_loading)
    {
        <p class="mu" role="status">Loading resources…</p>
    }
    else if (_latest.Count == 0)
    {
        <div class="w empty-state">
            <p class="px">THE VAULT IS EMPTY</p>
            <p>There are no resources to show yet. Check back soon for new community contributions.</p>
        </div>
    }
    else
    {
        <div class="grid latest-grid">
            @foreach (var resource in _latest)
            {
                var preview = resource.PreviewMedia.OrderBy(item => item.SortOrder).FirstOrDefault();
                <article class="w card latest-card">
                    <a class="card-preview" href="@($"/Resource/{resource.Id}")" aria-label="Open @resource.Name">
                        @if (preview is not null)
                        {
                            <MediaCarousel Media="new[] { preview }" ResourceId="resource.Id" />
                        }
                        else
                        {
                            <img src="images/logo-box.png" alt="" loading="lazy" />
                        }
                    </a>
                    <span class="t">@resource.ResourceType?.Name</span>
                    <h3><a href="@($"/Resource/{resource.Id}")">@resource.Name</a></h3>
                    <p class="g">@resource.Videogame?.Name · v@(resource.Version ?? "—")</p>
                    <p class="card-description">@ShortDescription(resource.Description)</p>
                    <div class="meta"><span>@resource.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span><span>↓ @(resource.Downloads ?? 0)</span></div>
                </article>
            }
        </div>
    }
</section>

@code {
    private string _landingText = "The community vault for SNES hacks, homebrew, and creative projects.";
    private List<Resource> _latest = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _landingText = await Content.ReadAsync("landing");
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var candidates = await Context.Resources
            .Include(resource => resource.Visibility)
            .Include(resource => resource.Videogame)
            .Include(resource => resource.ResourceType)
            .Include(resource => resource.PreviewMedia)
                .ThenInclude(media => media.File)
                    .ThenInclude(file => file!.FileType)
            .Include(resource => resource.PreviewMedia)
                .ThenInclude(media => media.PosterFile)
                    .ThenInclude(file => file!.FileType)
            .AsNoTracking()
            .OrderByDescending(resource => resource.CreatedAt)
            .Take(50)
            .ToListAsync();

        foreach (var candidate in candidates)
        {
            if (await Access.CanListAsync(candidate, user))
                _latest.Add(candidate);
            if (_latest.Count == 5)
                break;
        }

        _loading = false;
    }

    private static string ShortDescription(string? description)
    {
        var text = string.IsNullOrWhiteSpace(description) ? "No description." : description.Trim();
        return text.Length <= 150 ? text : text[..147] + "…";
    }
}
