@page "/"
@page "/Home/Index"
@using SNEStorage.Components.Resources
@using SNEStorage.Components.News

<PageTitle>SNEStorage | SNES Resource Archive</PageTitle>
<div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="hero-stage">
            <img class="hero-logo" src="images/snestorageLogo.png" alt="The SNEStorage mascot carrying a box of resources" width="2470" height="2140" fetchpriority="high" />
        </div>
        <div class="hero-copy">
            <h1 id="home-title">SNEStorage</h1>
            <p>Resources for SNES hacking, homebrew, and the projects you create.</p>
        </div>
    </section>
    <div class="home-feeds">
        <section class="latest-section" aria-labelledby="news-title">
            <div class="latest-heading">
                <h2 id="news-title">Latest news</h2>
                <a class="library-link" href="/News">All news <span aria-hidden="true">→</span></a>
            </div>
            <NewsFeed Compact="true" />
        </section>
        <section class="latest-section" aria-labelledby="latest-title">
            <div class="latest-heading">
                <h2 id="latest-title">Latest resources</h2>
                <a class="library-link" href="/Resources">All resources <span aria-hidden="true">→</span></a>
            </div>
            <LatestResources Compact="true" />
        </section>
    </div>
</div>
