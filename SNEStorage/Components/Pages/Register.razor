@page "/Register"
@inject UserManager<ApplicationUser> UserManager
@inject SnestorageContext Context
@inject FileService FileService
@inject NavigationManager Navigation
@inject ILogger<Register> Logger

<PageTitle>Create account | SNEStorage</PageTitle>

<section class="w auth-panel">
    <p class="eyebrow">JOIN THE COMMUNITY</p>
    <h1>Create account</h1>
    <p class="mu">Create your space in the SNES resource vault.</p>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice" role="alert">@_message</div>
    }

    <EditForm Model="_form" OnValidSubmit="RegisterAsync" FormName="register">
        <DataAnnotationsValidator />
        <ValidationSummary class="err-msg" />

        <div class="row">
            <div class="f"><label for="register-user">Username</label><InputText id="register-user" @bind-Value="_form.User" autocomplete="username" /><ValidationMessage For="() => _form.User" /></div>
            <div class="f"><label for="register-email">Email address</label><InputText id="register-email" @bind-Value="_form.Email" type="email" autocomplete="email" /><ValidationMessage For="() => _form.Email" /></div>
            <div class="f"><label for="register-password">Password</label><InputText id="register-password" @bind-Value="_form.Password" type="password" autocomplete="new-password" /><ValidationMessage For="() => _form.Password" /></div>
            <div class="f"><label for="register-repeat">Confirm password</label><InputText id="register-repeat" @bind-Value="_form.PasswordRepeat" type="password" autocomplete="new-password" /><ValidationMessage For="() => _form.PasswordRepeat" /></div>
            <div class="f"><label for="register-birthday">Date of birth</label><InputDate id="register-birthday" @bind-Value="_form.Birthday" /><ValidationMessage For="() => _form.Birthday" /></div>
            <div class="f"><label for="register-color">Username color</label><InputText id="register-color" @bind-Value="_form.UsernameColor" type="color" /></div>
            <div class="f">
                <label for="register-timezone">Time zone</label>
                <InputSelect id="register-timezone" @bind-Value="_form.TimeZoneId">
                    <option value="">Select a time zone</option>
                    @foreach (var zone in _timeZones) { <option value="@zone.Id">@zone.Name</option> }
                </InputSelect>
                <ValidationMessage For="() => _form.TimeZoneId" />
            </div>
            <div class="f">
                <label for="register-email-visibility">Email visibility</label>
                <InputSelect id="register-email-visibility" @bind-Value="_form.EmailVisibilityId">
                    <option value="">Select visibility</option>
                    @foreach (var visibility in _emailVisibilities) { <option value="@visibility.Id">@visibility.Name</option> }
                </InputSelect>
                <ValidationMessage For="() => _form.EmailVisibilityId" />
            </div>
            <div class="f f-wide">
                <label for="register-avatar">Avatar (PNG or JPG, max 5 MB)</label>
                <InputFile id="register-avatar" OnChange="SelectAvatar" accept=".png,.jpg,.jpeg,image/png,image/jpeg" />
                @if (_avatar is not null) { <small>@_avatar.Name</small> }
            </div>
        </div>

        <button class="y" type="submit" disabled="@_saving">@(_saving ? "Creating account…" : "Create account")</button>
    </EditForm>

    <p class="auth-foot">Already have an account? <a href="/Login">Sign in</a></p>
</section>

@code {
    private const long MaxAvatarSize = 5 * 1024 * 1024;
    private readonly RegisterForm _form = new();
    private List<SNEStorage.Models.TimeZone> _timeZones = [];
    private List<Visibility> _emailVisibilities = [];
    private IBrowserFile? _avatar;
    private string? _message;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _timeZones = await Context.TimeZones.AsNoTracking().OrderBy(zone => zone.Name).ToListAsync();
        _emailVisibilities = await Context.Visibilities.AsNoTracking()
            .Where(visibility => !visibility.ResourceOnly)
            .OrderBy(visibility => visibility.Name)
            .ToListAsync();
    }

    private void SelectAvatar(InputFileChangeEventArgs args) => _avatar = args.File;

    private async Task RegisterAsync()
    {
        if (_avatar is null || _avatar.Size is <= 0 or > MaxAvatarSize ||
            _avatar.ContentType is not ("image/png" or "image/jpeg"))
        {
            _message = "Choose a PNG or JPG avatar up to 5 MB.";
            return;
        }
        if (_form.TimeZoneId is null || _form.EmailVisibilityId is null)
        {
            _message = "Complete the time zone and email visibility fields.";
            return;
        }

        _saving = true;
        _message = null;
        try
        {
            var user = new ApplicationUser { UserName = _form.User.Trim(), Email = _form.Email.Trim() };
            var createResult = await UserManager.CreateAsync(user, _form.Password);
            if (!createResult.Succeeded)
            {
                _message = string.Join(" ", createResult.Errors.Select(error => error.Description));
                return;
            }

            await using var buffer = new MemoryStream();
            await _avatar.OpenReadStream(MaxAvatarSize).CopyToAsync(buffer);
            buffer.Position = 0;
            var upload = new FormFile(buffer, 0, buffer.Length, "File", Path.GetFileName(_avatar.Name))
            {
                Headers = new HeaderDictionary(),
                ContentType = _avatar.ContentType
            };
            var path = Path.Combine("avatars", $"{Guid.NewGuid():N}{Path.GetExtension(_avatar.Name).ToLowerInvariant()}");
            var savedAvatar = await FileService.CreateAsync(upload, path, CancellationToken.None);
            if (savedAvatar is null)
            {
                _message = "Your account was created, but the avatar could not be saved. Contact support.";
                return;
            }

            Context.UserInfos.Add(new UserInfo
            {
                UserId = user.Id,
                UsernameColor = IsHexColor(_form.UsernameColor) ? _form.UsernameColor : "#E7E2FF",
                AvatarId = savedAvatar.Id,
                Birthday = _form.Birthday!.Value,
                TimeZoneId = _form.TimeZoneId.Value,
                EmailVisibilityId = _form.EmailVisibilityId.Value
            });
            await Context.SaveChangesAsync();
            Navigation.NavigateTo("/Login?registered=1", forceLoad: true);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Account registration failed.");
            _message ??= "Registration failed. Check your details and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static bool IsHexColor(string? value) =>
        value is { Length: 7 } && value[0] == '#' && value[1..].All(Uri.IsHexDigit);

    private sealed class RegisterForm
    {
        [Required, StringLength(40, MinimumLength = 3)] public string User { get; set; } = string.Empty;
        [Required, EmailAddress] public string Email { get; set; } = string.Empty;
        [Required, MinLength(8)] public string Password { get; set; } = string.Empty;
        [Required, Compare(nameof(Password), ErrorMessage = "Passwords do not match.")] public string PasswordRepeat { get; set; } = string.Empty;
        public string? UsernameColor { get; set; } = "#E7E2FF";
        [Required] public DateOnly? Birthday { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        [Required] public long? TimeZoneId { get; set; }
        [Required] public long? EmailVisibilityId { get; set; }
    }
}
