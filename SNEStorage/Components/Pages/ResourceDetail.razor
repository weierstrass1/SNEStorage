@page "/Resource/{Id:long}"
@inject SnestorageContext Context
@inject ResourceAccessService Access
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@if (_loading)
{
    <PageTitle>Loading resource | SNEStorage</PageTitle>
    <p class="mu" role="status">Opening resource…</p>
}
else if (_notFound)
{
    <PageTitle>Error 404 | SNEStorage</PageTitle>
    <section class="w errp"><p class="code">404</p><h1>Resource not found</h1><a class="btn y" href="/Resource">Back to resources</a></section>
}
else if (_loginRequired)
{
    <PageTitle>Error 401 | SNEStorage</PageTitle>
    <section class="w errp">
        <p class="code">401</p>
        <h1>Sign in to view this resource</h1>
        <p>This resource is private and available only to its uploader and authors.</p>
        <a class="btn y" href="@($"/Login?returnUrl={Uri.EscapeDataString($"/Resource/{Id}")}")">Sign in</a>
    </section>
}
else if (!_canView)
{
    <PageTitle>Error 403 | SNEStorage</PageTitle>
    <section class="w errp">
        <p class="code">403</p>
        <h1>Private resource</h1>
        <p>This resource is only available to its uploader, authors, and moderators.</p>
        <a class="btn y" href="/Resource">Back to resources</a>
    </section>
}
else if (_resource is { } resource)
{
    <PageTitle>@resource.Name | SNEStorage</PageTitle>
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/Resource">Resources</a><span>›</span><span>@resource.Name</span></nav>

    <section class="w resource-detail">
        <div class="dh">
            <div>
                <p class="eyebrow">@(resource.Videogame?.Name ?? "SNES RESOURCE") · @(resource.ResourceType?.Name ?? "RESOURCE")</p>
                <h1>@resource.Name</h1>
                <p class="mu">@(resource.Usage ?? "")</p>
            </div>
            <a class="btn y download-button" href="@($"/Resource/Download?id={resource.Id}")">Download resource ↓</a>
        </div>

        @if (ResourceAccessService.IsUnlisted(resource.Visibility?.Name))
        {
            <p class="visibility-note"><strong>Unlisted resource.</strong> Only people with the link can find it.</p>
        }
        @if (Access.IsStaff(_user))
        {
            <p class="visibility-note">Visibility: <strong>@resource.Visibility?.Name</strong></p>
        }

        <div class="stats">
            <div>@(resource.Version ?? "—")<span>VERSION</span></div>
            <div>@resource.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")<span>PUBLISHED</span></div>
            <div>@resource.LastUpdate.ToLocalTime().ToString("yyyy-MM-dd")<span>UPDATED</span></div>
            <div>@(resource.Downloads ?? 0)<span>DOWNLOADS</span></div>
            <div>@_averageRating.ToString("0.0") / 5<span>RATING</span></div>
        </div>

        @if (HasFlags(resource))
        {
            <aside class="content-flags" aria-label="Content warnings">
                <strong>CONTENT WARNINGS</strong>
                @if (resource.IncludesPorn) { <span class="badge">Sexual content</span> }
                @if (resource.IncludesGore) { <span class="badge">Gore</span> }
                @if (resource.IncludesPolitics) { <span class="badge">Political content</span> }
                @if (resource.IncludesSensitiveContent) { <span class="badge">Sensitive content</span> }
                @if (resource.IncludesSlurs) { <span class="badge">Slurs or discrimination</span> }
            </aside>
        }

        <div class="detail-grid">
            <div class="detail-main">
                <h2>Previews</h2>
                <MediaCarousel Media="_media" ResourceId="resource.Id" />
                <section class="sec desc-full">
                    <h2>Description</h2>
                    <p>@(string.IsNullOrWhiteSpace(resource.Description) ? "This resource does not have a description yet." : resource.Description)</p>
                </section>
                @if (resource.ResourceTags.Count > 0)
                {
                    <section class="sec">
                        <h2>Tags</h2>
                        <div class="chips">
                            @foreach (var resourceTag in resource.ResourceTags.OrderBy(item => item.Tag?.Name))
                            {
                                <span class="chip">@resourceTag.Tag?.Name</span>
                            }
                        </div>
                    </section>
                }
            </div>
            <aside class="detail-aside">
                <h2>Information</h2>
                <dl class="detail-facts">
                    <dt>Game</dt><dd>@(resource.Videogame?.Name ?? "Not specified")</dd>
                    <dt>Type</dt><dd>@(resource.ResourceType?.Name ?? "Not specified")</dd>
                    <dt>Purpose</dt><dd>@(resource.Usage ?? "Not specified")</dd>
                    <dt>Uploaded by</dt><dd>@(resource.SubmitterUser?.UserName ?? "Member")</dd>
                    <dt>Authors</dt><dd>@AuthorSummary(resource)</dd>
                    <dt>File</dt><dd>@Path.GetFileName(resource.File?.URL ?? "resource")</dd>
                    <dt>Visibility</dt><dd>@(resource.Visibility?.Name ?? "—")</dd>
                </dl>
                <p class="stars detail-stars" aria-label="@_averageRating.ToString("0.0") out of five stars">@RatingStars(_averageRating)</p>
                <p class="mu">@_ratingCount ratings</p>
                @if (_signedIn)
                {
                    <fieldset class="rating-picker">
                        <legend>Your rating</legend>
                        @for (var star = 1; star <= 5; star++)
                        {
                            var value = star;
                            <button type="button" class="rating-star" aria-label="Rate @value stars" @onclick="() => RateAsync(value)">@(value <= _myRating ? "★" : "☆")</button>
                        }
                    </fieldset>
                }
                else
                {
                    <a href="@($"/Login?returnUrl={Uri.EscapeDataString($"/Resource/{resource.Id}")}")">Sign in to rate</a>
                }
            </aside>
        </div>
    </section>

    <section class="w comments-section">
        <div class="section-heading">
            <div><p class="eyebrow">THE COMMUNITY</p><h2>Comments (@_comments.Count)</h2></div>
        </div>
        @if (_signedIn)
        {
            <form class="comment-form" @onsubmit="PostCommentAsync" @onsubmit:preventDefault>
                <label for="new-comment">Leave a comment</label>
                <textarea id="new-comment" @bind="_commentText" maxlength="5000" placeholder="Share a question or comment about this resource…" required></textarea>
                <button class="btn y" type="submit" disabled="@string.IsNullOrWhiteSpace(_commentText)">Post comment</button>
            </form>
        }
        else
        {
            <p class="mu">To comment, reply, or vote, you need to <a href="@($"/Login?returnUrl={Uri.EscapeDataString($"/Resource/{resource.Id}")}")">sign in</a>.</p>
        }

        @if (!string.IsNullOrWhiteSpace(_commentMessage))
        {
            <p class="err-msg" role="alert">@_commentMessage</p>
        }
        @if (_comments.Count == 0)
        {
            <p class="empty-comments mu">There are no comments yet. Start the conversation.</p>
        }
        else
        {
            <div class="comment-list">
                @foreach (var comment in _comments.Where(item => item.ParentCommentId is null).OrderBy(item => item.PublishDate))
                {
                    <CommentThread @key="comment.Id" Comment="comment" AllComments="_comments" CanInteract="_signedIn" OnVote="VoteOnCommentAsync" OnReply="ReplyToCommentAsync" />
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public long Id { get; set; }

    private Resource? _resource;
    private List<ResourceMedia> _media = [];
    private List<Comment> _comments = [];
    private List<ScoreUsers> _ratings = [];
    private ClaimsPrincipal _user = new(new ClaimsIdentity());
    private string? _userId;
    private string _commentText = string.Empty;
    private string? _commentMessage;
    private double _averageRating;
    private int _ratingCount;
    private long _myRating;
    private bool _signedIn;
    private bool _loginRequired;
    private bool _canView;
    private bool _notFound;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _user = state.User;
        _signedIn = _user.Identity?.IsAuthenticated == true;
        _userId = _user.FindFirstValue(ClaimTypes.NameIdentifier);

        _resource = await Context.Resources
            .Include(item => item.Visibility)
            .Include(item => item.Videogame)
            .Include(item => item.ResourceType)
            .Include(item => item.SubmitterUser)
            .Include(item => item.File)
                .ThenInclude(file => file!.FileType)
            .Include(item => item.Score)
                .ThenInclude(score => score!.ScoresUsers)
            .Include(item => item.ResourcesAuthors)
                .ThenInclude(author => author.User)
            .Include(item => item.ResourceExternalAuthors)
            .Include(item => item.ResourceTags)
                .ThenInclude(resourceTag => resourceTag.Tag)
            .Include(item => item.PreviewMedia)
                .ThenInclude(media => media.File)
                    .ThenInclude(file => file!.FileType)
            .Include(item => item.PreviewMedia)
                .ThenInclude(media => media.PosterFile)
                    .ThenInclude(file => file!.FileType)
            .AsNoTracking()
            .FirstOrDefaultAsync(item => item.Id == Id);

        _notFound = _resource is null;
        _loginRequired = _resource is not null && !_signedIn && ResourceAccessService.IsPrivate(_resource.Visibility?.Name);
        _canView = _resource is not null && await Access.CanViewAsync(_resource, _user, directLink: true);
        if (_resource is not null && _canView)
        {
            _media = _resource.PreviewMedia.OrderBy(item => item.SortOrder).ToList();
            if (_media.Count == 0 && (_resource.File?.FileType?.Value.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true ||
                                      _resource.File?.FileType?.Value.StartsWith("video/", StringComparison.OrdinalIgnoreCase) == true))
                _media.Add(new ResourceMedia { ResourceId = _resource.Id, File = _resource.File });

            await LoadRatingsAsync();
            await LoadCommentsAsync();
        }

        _loading = false;
    }

    private async Task LoadRatingsAsync()
    {
        if (_resource is null)
            return;

        _ratings = await Context.ScoresUsers
            .Where(item => item.ScoreId == _resource.ScoreId && item.Value >= 1 && item.Value <= 5)
            .AsNoTracking()
            .ToListAsync();
        _ratingCount = _ratings.Count;
        _averageRating = _ratingCount == 0 ? 0 : _ratings.Average(item => item.Value);
        _myRating = string.IsNullOrWhiteSpace(_userId)
            ? 0
            : _ratings.FirstOrDefault(item => item.UserId == _userId)?.Value ?? 0;
    }

    private async Task LoadCommentsAsync()
    {
        if (_resource is null)
            return;

        _comments = await Context.Comments
            .Where(comment => comment.ResourceComments.Any(link => link.ResourceId == _resource.Id))
            .Include(comment => comment.User)
            .Include(comment => comment.Score)
                .ThenInclude(score => score!.LikesUsers)
            .AsNoTracking()
            .OrderBy(comment => comment.PublishDate)
            .ToListAsync();
    }

    private async Task RateAsync(int value)
    {
        if (_resource is null || string.IsNullOrWhiteSpace(_userId))
            return;

        var rating = await Context.ScoresUsers.FirstOrDefaultAsync(item =>
            item.ScoreId == _resource.ScoreId && item.UserId == _userId);
        if (rating is null)
        {
            Context.ScoresUsers.Add(new ScoreUsers { ScoreId = _resource.ScoreId, UserId = _userId, Value = value });
        }
        else
        {
            rating.Value = value;
        }

        await Context.SaveChangesAsync();
        await LoadRatingsAsync();
    }

    private async Task PostCommentAsync()
    {
        var text = _commentText.Trim();
        if (_resource is null || string.IsNullOrWhiteSpace(_userId) || text.Length is 0 or > 5000)
            return;

        var score = new Score();
        Context.Scores.Add(score);
        await Context.SaveChangesAsync();
        Context.Comments.Add(new Comment
        {
            Text = text,
            UserId = _userId,
            ScoreId = score.Id,
            PublishDate = DateTime.UtcNow
        });
        await Context.SaveChangesAsync();
        var comment = await Context.Comments.OrderByDescending(item => item.Id).FirstAsync(item => item.ScoreId == score.Id);
        Context.ResourcesComments.Add(new ResourceComments { ResourceId = _resource.Id, CommentId = comment.Id });
        await Context.SaveChangesAsync();
        _commentText = string.Empty;
        _commentMessage = null;
        await LoadCommentsAsync();
    }

    private async Task ReplyToCommentAsync(CommentReplyRequest reply)
    {
        var text = reply.Text.Trim();
        if (_resource is null || string.IsNullOrWhiteSpace(_userId) || text.Length is 0 or > 2000 ||
            !_comments.Any(comment => comment.Id == reply.ParentCommentId))
        {
            _commentMessage = "Could not send that reply.";
            return;
        }

        var score = new Score();
        Context.Scores.Add(score);
        await Context.SaveChangesAsync();
        Context.Comments.Add(new Comment
        {
            Text = text,
            UserId = _userId,
            ScoreId = score.Id,
            ParentCommentId = reply.ParentCommentId,
            PublishDate = DateTime.UtcNow
        });
        await Context.SaveChangesAsync();
        var comment = await Context.Comments.OrderByDescending(item => item.Id).FirstAsync(item => item.ScoreId == score.Id);
        Context.ResourcesComments.Add(new ResourceComments { ResourceId = _resource.Id, CommentId = comment.Id });
        await Context.SaveChangesAsync();
        _commentMessage = null;
        await LoadCommentsAsync();
    }

    private async Task VoteOnCommentAsync(CommentVoteRequest vote)
    {
        if (string.IsNullOrWhiteSpace(_userId))
            return;

        var currentVote = await Context.LikesUsers.FirstOrDefaultAsync(item =>
            item.ScoreId == vote.ScoreId && item.UserId == _userId);
        if (currentVote is null)
        {
            Context.LikesUsers.Add(new LikeUsers { ScoreId = vote.ScoreId, UserId = _userId, Value = vote.IsLike });
        }
        else if (currentVote.Value == vote.IsLike)
        {
            Context.LikesUsers.Remove(currentVote);
        }
        else
        {
            currentVote.Value = vote.IsLike;
        }

        await Context.SaveChangesAsync();
        await LoadCommentsAsync();
    }

    private static bool HasFlags(Resource resource) =>
        resource.IncludesPorn || resource.IncludesGore || resource.IncludesPolitics ||
        resource.IncludesSensitiveContent || resource.IncludesSlurs;

    private static string RatingStars(double average)
    {
        var filled = (int)Math.Round(average, MidpointRounding.AwayFromZero);
        return new string('★', filled) + new string('☆', 5 - filled);
    }

    private static string AuthorSummary(Resource resource)
    {
        var authors = resource.ResourcesAuthors.Select(item => item.User?.UserName)
            .Concat(resource.ResourceExternalAuthors.Select(item => item.Author))
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList();
        return authors.Count == 0 ? "No especificado" : string.Join(", ", authors);
    }
}
