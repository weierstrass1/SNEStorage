@page "/Resource"
@inject SnestorageContext Context
@inject ResourceAccessService Access
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Resources | SNEStorage</PageTitle>

<section class="page-heading">
    <p class="eyebrow">THE COMMUNITY LIBRARY</p>
    <div class="heading-row">
        <div>
            <h1>Resources</h1>
            <p class="mu">Patches, tools, music, graphics, and projects for SNES.</p>
        </div>
        <AuthorizeView>
            <Authorized>
                @if (Access.CanUpload(context.User))
                {
                    <a class="btn y" href="/Resources/Create">＋ Upload resource</a>
                }
            </Authorized>
        </AuthorizeView>
    </div>
</section>

<form class="w filters" method="get" action="/Resource">
    <div class="row">
        <div class="f search-field">
            <label for="resource-q">Search</label>
            <input id="resource-q" type="search" name="q" value="@Query" placeholder="Name, purpose, or description" />
        </div>
        <div class="f">
            <label for="resource-game">Game</label>
            <select id="resource-game" name="game">
                <option value="">Any game</option>
                @foreach (var game in _games)
                {
                    <option value="@game.Id" selected="@(GameId == game.Id)">@game.Name</option>
                }
            </select>
        </div>
        <div class="f">
            <label for="resource-type">Type</label>
            <select id="resource-type" name="type">
                <option value="">All types</option>
                @foreach (var type in _types)
                {
                    <option value="@type.Id" selected="@(TypeId == type.Id)">@type.Name</option>
                }
            </select>
        </div>
        <div class="f">
                <label for="resource-sort">Sort by</label>
            <select id="resource-sort" name="sort">
                <option value="newest" selected="@(Sort != "rating" && Sort != "downloads" && Sort != "oldest")">Newest</option>
                <option value="oldest" selected="@(Sort == "oldest")">Oldest</option>
                <option value="rating" selected="@(Sort == "rating")">Highest rated</option>
                <option value="downloads" selected="@(Sort == "downloads")">Most downloaded</option>
            </select>
        </div>
        <div class="f">
            <label for="resource-content">Content</label>
            <select id="resource-content" name="content">
                <option value="all" selected="@(ContentFilter != "safe")">Show all</option>
                <option value="safe" selected="@(ContentFilter == "safe")">Hide sensitive content</option>
            </select>
        </div>
        <input type="hidden" name="page" value="1" />
        <div class="f filter-submit"><button class="y" type="submit">Filter</button></div>
    </div>
</form>

<div class="bar">
    <span>@_totalCount resources found</span>
    <span>@(Access.IsStaff(_currentUser) ? "Moderation view" : "Public resources only")</span>
</div>

@if (_loading)
{
    <p class="mu" role="status">Loading resources…</p>
}
else if (_pageResources.Count == 0)
{
    <section class="w empty-state">
        <p class="px">NO MATCHES FOUND</p>
        <p>Try removing a filter or searching for different terms.</p>
        <a class="btn sm" href="/Resource">Clear filters</a>
    </section>
}
else
{
    <div class="tw">
        <table class="resource-table">
            <thead>
                <tr>
                    <th scope="col">Resource</th>
                    <th scope="col">Author</th>
                    <th scope="col">Created</th>
                    <th scope="col">Downloads</th>
                    <th scope="col">Rating</th>
                    <th scope="col">Warnings</th>
                    <th scope="col">File</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var resource in _pageResources)
                {
                    var authorNames = GetAuthors(resource);
                    <tr>
                        <td class="resource-cell">
                            <a class="resource-title" href="@($"/Resource/{resource.Id}")">@resource.Name</a>
                            <span class="d">@resource.Videogame?.Name · @resource.ResourceType?.Name · v@(resource.Version ?? "—")</span>
                            <span class="resource-summary">@ShortDescription(resource.Description)</span>
                            @if (Access.IsStaff(_currentUser) && resource.Visibility?.Name is { } visibilityName && !ResourceAccessService.IsPublic(visibilityName))
                            {
                                <span class="badge v">@visibilityName</span>
                            }
                        </td>
                        <td class="author-cell" title="@string.Join(", ", authorNames)">
                            @if (authorNames.Count == 0)
                            {
                                <span class="ext">No author</span>
                            }
                            else
                            {
                                <span>@authorNames[0]</span>
                                @if (authorNames.Count > 1)
                                {
                                    <span class="ext" aria-label="More authors"> …</span>
                                }
                            }
                            <span class="d">Uploaded by @resource.SubmitterUser?.UserName</span>
                        </td>
                        <td class="c">@resource.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td class="c">@(resource.Downloads ?? 0)</td>
                        <td class="c">
                            <span class="stars" aria-label="@Average(resource).ToString("0.0") out of 5 stars">@Stars(resource)</span>
                            <span class="d">@Average(resource).ToString("0.0")/5</span>
                        </td>
                        <td class="flag-cell">@RenderFlags(resource)</td>
                        <td class="c"><a class="btn sm" href="@($"/Resource/Download?id={resource.Id}")">Download</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_pageCount > 1)
    {
        <nav class="pager" aria-label="Pagination">
            @if (PageNumber > 1)
            {
                <a class="btn sm" href="@PageUrl(PageNumber - 1)">← Previous</a>
            }
            @for (var page = 1; page <= _pageCount; page++)
            {
                var targetPage = page;
                <a class="btn sm @(targetPage == PageNumber ? "cur" : null)" href="@PageUrl(targetPage)" aria-current="@(targetPage == PageNumber ? "page" : null)">@targetPage</a>
            }
            @if (PageNumber < _pageCount)
            {
                <a class="btn sm" href="@PageUrl(PageNumber + 1)">Next →</a>
            }
        </nav>
    }
}

@code {
    private const int PageSize = 12;
    private ClaimsPrincipal _currentUser = new(new ClaimsIdentity());
    private List<Videogame> _games = [];
    private List<ResourceType> _types = [];
    private List<Resource> _pageResources = [];
    private int _totalCount;
    private int _pageCount;
    private bool _loading = true;

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "game")] public long? GameId { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public long? TypeId { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "content")] public string? ContentFilter { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int PageNumber { get; set; } = 1;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _currentUser = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _games = await Context.Videogames.AsNoTracking().OrderBy(game => game.Name).ToListAsync();
        _types = await Context.ResourceTypes.AsNoTracking().OrderBy(type => type.Name).ToListAsync();

        var resources = await Context.Resources
            .Include(resource => resource.Visibility)
            .Include(resource => resource.Videogame)
            .Include(resource => resource.ResourceType)
            .Include(resource => resource.SubmitterUser)
            .Include(resource => resource.Score)
                .ThenInclude(score => score!.ScoresUsers)
            .Include(resource => resource.ResourcesAuthors)
                .ThenInclude(author => author.User)
            .Include(resource => resource.ResourceExternalAuthors)
            .AsNoTracking()
            .ToListAsync();

        var visible = new List<Resource>();
        foreach (var resource in resources)
        {
            if (await Access.CanListAsync(resource, _currentUser))
                visible.Add(resource);
        }

        IEnumerable<Resource> filtered = visible;
        if (!string.IsNullOrWhiteSpace(Query))
        {
            var term = Query.Trim();
            filtered = filtered.Where(resource =>
                (resource.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (resource.Usage?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (resource.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (resource.Videogame?.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        if (GameId.HasValue)
            filtered = filtered.Where(resource => resource.VideogameId == GameId.Value);
        if (TypeId.HasValue)
            filtered = filtered.Where(resource => resource.ResourceTypeId == TypeId.Value);
        if (ContentFilter == "safe")
            filtered = filtered.Where(resource => !HasFlags(resource));

        filtered = Sort switch
        {
            "oldest" => filtered.OrderBy(resource => resource.CreatedAt),
            "rating" => filtered.OrderByDescending(Average).ThenByDescending(resource => resource.CreatedAt),
            "downloads" => filtered.OrderByDescending(resource => resource.Downloads ?? 0),
            _ => filtered.OrderByDescending(resource => resource.CreatedAt)
        };

        var results = filtered.ToList();
        _totalCount = results.Count;
        _pageCount = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
        PageNumber = Math.Clamp(PageNumber, 1, _pageCount);
        _pageResources = results.Skip((PageNumber - 1) * PageSize).Take(PageSize).ToList();
        _loading = false;
    }

    private static List<string> GetAuthors(Resource resource) => resource.ResourcesAuthors
        .Select(item => item.User?.UserName)
        .Concat(resource.ResourceExternalAuthors.Select(item => item.Author))
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Select(name => name!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private static double Average(Resource resource)
    {
        var ratings = resource.Score?.ScoresUsers.Select(item => item.Value).Where(value => value is >= 1 and <= 5).ToList() ?? [];
        return ratings.Count == 0 ? 0 : ratings.Average();
    }

    private static string Stars(Resource resource)
    {
        var rounded = (int)Math.Round(Average(resource), MidpointRounding.AwayFromZero);
        return new string('★', rounded) + new string('☆', 5 - rounded);
    }

    private static bool HasFlags(Resource resource) =>
        resource.IncludesPorn || resource.IncludesGore || resource.IncludesPolitics ||
        resource.IncludesSensitiveContent || resource.IncludesSlurs;

    private static string ShortDescription(string? description)
    {
        var text = string.IsNullOrWhiteSpace(description) ? "No description." : description.Trim();
        return text.Length <= 170 ? text : text[..167] + "…";
    }

    private static RenderFragment RenderFlags(Resource resource) => builder =>
    {
        var flags = new List<string>();
        if (resource.IncludesPorn) flags.Add("Sexual");
        if (resource.IncludesGore) flags.Add("Gore");
        if (resource.IncludesPolitics) flags.Add("Political content");
        if (resource.IncludesSensitiveContent) flags.Add("Sensible");
        if (resource.IncludesSlurs) flags.Add("Insultos");

        if (flags.Count == 0)
        {
            builder.AddContent(0, "—");
            return;
        }

        var sequence = 0;
        foreach (var flag in flags)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "badge");
            builder.AddContent(sequence++, flag);
            builder.CloseElement();
        }
    };

    private string PageUrl(int page)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(Query)) parts.Add($"q={Uri.EscapeDataString(Query)}");
        if (GameId.HasValue) parts.Add($"game={GameId.Value}");
        if (TypeId.HasValue) parts.Add($"type={TypeId.Value}");
        if (!string.IsNullOrWhiteSpace(Sort)) parts.Add($"sort={Uri.EscapeDataString(Sort)}");
        if (!string.IsNullOrWhiteSpace(ContentFilter)) parts.Add($"content={Uri.EscapeDataString(ContentFilter)}");
        parts.Add($"page={page}");
        return "/Resource?" + string.Join("&", parts);
    }
}
