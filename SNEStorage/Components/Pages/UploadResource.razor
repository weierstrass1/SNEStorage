@page "/Resources/Create"
@attribute [Authorize]
@inject SnestorageContext Context
@inject FileService FileService
@inject ResourceAccessService Access
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject EditableContentService Content
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<UploadResource> Logger

<PageTitle>Upload resource | SNEStorage</PageTitle>

<section class="page-heading">
    <p class="eyebrow">CONTRIBUTE TO THE VAULT</p>
    <h1>Upload a resource</h1>
    <p class="mu">Tell the community what your contribution does and how to use it.</p>
</section>

@if (!_canUpload)
{
    <section class="w errp">
        <p class="code">403</p>
        <h2>Posting restricted</h2>
        <p>Sign in to publish resources in the vault.</p>
        <a class="btn" href="/Resource">Back to resources</a>
    </section>
}
else
{
    <details class="w rules-collapse">
        <summary>Resource submission rules</summary>
        <div class="editable-copy">@_rules</div>
        <a href="/Rules">Read all rules →</a>
    </details>

    <section class="w upload-panel">
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="notice" role="alert">@_message</div>
        }

        <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="upload-resource">
            <DataAnnotationsValidator />
            <ValidationSummary class="err-msg" />

            <div class="row">
                <div class="f">
                    <label for="upload-name">Resource name</label>
                    <InputText id="upload-name" @bind-Value="_form.Name" />
                    <ValidationMessage For="() => _form.Name" />
                </div>
                <div class="f">
                    <label for="upload-version">Version</label>
                    <InputText id="upload-version" @bind-Value="_form.Version" />
                    <ValidationMessage For="() => _form.Version" />
                </div>
                <div class="f">
                    <label for="upload-game">Game</label>
                    <InputSelect id="upload-game" @bind-Value="_form.VideogameId">
                        <option value="">Not specified</option>
                        @foreach (var game in _games)
                        {
                            <option value="@game.Id">@game.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="f">
                    <label for="upload-type">Resource type</label>
                    <InputSelect id="upload-type" @bind-Value="_form.ResourceTypeId">
                        <option value="">Not specified</option>
                        @foreach (var type in _types)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="f f-wide">
                    <label for="upload-usage">Primary purpose</label>
                    <InputText id="upload-usage" @bind-Value="_form.Usage" placeholder="What is this resource for?" />
                    <ValidationMessage For="() => _form.Usage" />
                </div>
                <div class="f f-wide">
                    <label for="upload-description">Description</label>
                    <InputTextArea id="upload-description" @bind-Value="_form.Description" rows="7" />
                    <ValidationMessage For="() => _form.Description" />
                </div>
                <div class="f">
                    <label for="upload-visibility">Visibility</label>
                    <InputSelect id="upload-visibility" @bind-Value="_form.VisibilityId">
                        @foreach (var visibility in _visibilities)
                        {
                            <option value="@visibility.Id">@visibility.Name</option>
                        }
                    </InputSelect>
                    <small>Private and unlisted resources do not appear in the public catalog.</small>
                </div>
                <div class="f">
                    <label for="upload-tags">Tags</label>
                    <InputText id="upload-tags" @bind-Value="_form.Tags" placeholder="music, tool, patch" />
                    <small>Separate them with commas.</small>
                </div>
                <div class="f f-wide">
                    <label for="upload-authors">Authors</label>
                    <InputText id="upload-authors" @bind-Value="_form.Authors" placeholder="Usernames or public names, separated by commas" />
                    <small>The uploader is recorded separately from the author.</small>
                </div>
                <div class="f f-wide">
                    <label for="upload-file">Downloadable file (max 100 MB)</label>
                    <InputFile id="upload-file" OnChange="SelectResourceFile" />
                    @if (_resourceFile is not null)
                    {
                        <small>@_resourceFile.Name · @FormatSize(_resourceFile.Size)</small>
                    }
                </div>
                <div class="f f-wide">
                    <label for="upload-previews">Preview images, GIFs, and videos</label>
                    <div @ref="_previewInputWrapper">
                        <InputFile id="upload-previews" OnChange="SelectPreviewFiles" multiple accept="image/png,image/jpeg,image/gif,image/webp,video/mp4,video/webm,video/ogg" />
                    </div>
                    <small>Up to 8 files, 25 MB each. Videos start paused and use a thumbnail from the first frame.</small>
                    @if (_previewFiles.Count > 0)
                    {
                        <ul class="selected-files">
                            @foreach (var preview in _previewFiles)
                            {
                                <li>@preview.Name · @FormatSize(preview.Size)</li>
                            }
                        </ul>
                    }
                    @if (_posterCaptureFailed)
                    {
                        <small class="err-msg">A video thumbnail could not be generated; the default thumbnail will be used.</small>
                    }
                </div>
            </div>

            <fieldset>
                <legend>Content warnings</legend>
                <label class="ck"><InputCheckbox @bind-Value="_form.IncludesGore" /> Violence or gore</label>
                <label class="ck"><InputCheckbox @bind-Value="_form.IncludesPolitics" /> Political content</label>
                <label class="ck"><InputCheckbox @bind-Value="_form.IncludesPorn" /> Sexual content</label>
                <label class="ck"><InputCheckbox @bind-Value="_form.IncludesSensitiveContent" /> Sensitive content</label>
                <label class="ck"><InputCheckbox @bind-Value="_form.IncludesSlurs" /> Slurs or discrimination</label>
            </fieldset>

            <button class="y" type="submit" disabled="@_saving">@(_saving ? "Saving…" : "Publish resource")</button>
        </EditForm>
    </section>
}

@code {
    private const long MaxResourceSize = 100 * 1024 * 1024;
    private const long MaxPreviewSize = 25 * 1024 * 1024;
    private readonly ResourceForm _form = new();
    private List<Videogame> _games = [];
    private List<ResourceType> _types = [];
    private List<Visibility> _visibilities = [];
    private readonly List<IBrowserFile> _previewFiles = [];
    private Dictionary<int, string> _posters = [];
    private IBrowserFile? _resourceFile;
    private ElementReference _previewInputWrapper;
    private string? _userId;
    private string? _message;
    private string _rules = string.Empty;
    private bool _canUpload;
    private bool _posterCaptureFailed;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _rules = await Content.ReadAsync("rules");
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        _canUpload = Access.CanUpload(user);
        if (!_canUpload)
            return;

        _games = await Context.Videogames.AsNoTracking().OrderBy(game => game.Name).ToListAsync();
        _types = await Context.ResourceTypes.AsNoTracking().OrderBy(type => type.Name).ToListAsync();
        _visibilities = await Context.Visibilities.AsNoTracking()
            .Where(visibility => visibility.ResourceOnly)
            .OrderBy(visibility => visibility.Name)
            .ToListAsync();
        _form.VisibilityId = _visibilities.FirstOrDefault(item => ResourceAccessService.IsPublic(item.Name))?.Id;
    }

    private void SelectResourceFile(InputFileChangeEventArgs args)
    {
        _resourceFile = args.File;
        _message = null;
    }

    private async Task SelectPreviewFiles(InputFileChangeEventArgs args)
    {
        _previewFiles.Clear();
        if (args.FileCount > 8)
        {
            _message = "Select up to 8 preview files.";
            return;
        }
        _previewFiles.AddRange(args.GetMultipleFiles(8));
        _posters.Clear();
        _posterCaptureFailed = false;
        _message = null;

        if (_previewFiles.Any(file => file.Size > MaxPreviewSize))
        {
            _message = "Each preview file must be 25 MB or smaller.";
            _previewFiles.Clear();
            return;
        }
        if (_previewFiles.Any(file => !IsAllowedPreview(file.ContentType)))
        {
            _message = "Previews must be PNG, JPG, GIF, WebP, MP4, WebM, or Ogg files.";
            _previewFiles.Clear();
            return;
        }

        try
        {
            var captured = await JS.InvokeAsync<PosterCapture[]>("SNEStorageMedia.captureFirstFrames", _previewInputWrapper);
            _posters = captured.ToDictionary(item => item.Index, item => item.DataUrl);
            _posterCaptureFailed = _previewFiles
                .Select((file, index) => (file, index))
                .Any(item => IsVideo(item.file) && !_posters.ContainsKey(item.index));
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not capture preview video posters in the browser.");
            _posterCaptureFailed = _previewFiles.Any(IsVideo);
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_userId) || _resourceFile is null || _resourceFile.Size <= 0 || _resourceFile.Size > MaxResourceSize)
        {
            _message = "Choose a valid file up to 100 MB.";
            return;
        }
        if (_form.VisibilityId is null || !_visibilities.Any(item => item.Id == _form.VisibilityId))
        {
            _message = "Choose a valid visibility setting.";
            return;
        }

        _saving = true;
        _message = null;
        try
        {
            var downloadableFile = await SaveBrowserFileAsync(_resourceFile, "resources");
            if (downloadableFile is null)
            {
                _message = "The downloadable file could not be saved.";
                return;
            }

            var score = new Score();
            Context.Scores.Add(score);
            await Context.SaveChangesAsync();

            var resource = new Resource
            {
                Name = _form.Name.Trim(),
                VideogameId = _form.VideogameId,
                ResourceTypeId = _form.ResourceTypeId,
                Usage = _form.Usage.Trim(),
                Description = _form.Description.Trim(),
                Version = _form.Version.Trim(),
                Downloads = 0,
                IncludesGore = _form.IncludesGore,
                IncludesPolitics = _form.IncludesPolitics,
                IncludesPorn = _form.IncludesPorn,
                IncludesSensitiveContent = _form.IncludesSensitiveContent,
                IncludesSlurs = _form.IncludesSlurs,
                VisibilityId = _form.VisibilityId.Value,
                FileId = downloadableFile.Id,
                SubmitterUserId = _userId,
                ScoreId = score.Id,
                CreatedAt = DateTime.UtcNow,
                LastUpdate = DateTime.UtcNow
            };
            Context.Resources.Add(resource);
            await Context.SaveChangesAsync();

            await SaveAuthorsAsync(resource.Id);
            await SaveTagsAsync(resource.Id);
            await SavePreviewsAsync(resource.Id);
            await Context.SaveChangesAsync();
            Navigation.NavigateTo($"/Resource/{resource.Id}");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Resource upload failed.");
            _message = "The resource could not be published. Check the file and server configuration.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<FileResponse?> SaveBrowserFileAsync(IBrowserFile browserFile, string folder)
    {
        var extension = Path.GetExtension(Path.GetFileName(browserFile.Name)).ToLowerInvariant();
        if (extension.Length > 12 || extension.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0)
            throw new InvalidOperationException("The file extension is invalid.");

        var path = BuildStoragePath(folder, extension);
        await using var buffer = new MemoryStream();
        await browserFile.OpenReadStream(folder == "resources" ? MaxResourceSize : MaxPreviewSize).CopyToAsync(buffer);
        buffer.Position = 0;
        var formFile = new FormFile(buffer, 0, buffer.Length, "File", Path.GetFileName(browserFile.Name))
        {
            Headers = new HeaderDictionary(),
            ContentType = browserFile.ContentType
        };
        return await FileService.CreateAsync(formFile, path, CancellationToken.None);
    }

    private async Task SavePreviewsAsync(long resourceId)
    {
        for (var index = 0; index < _previewFiles.Count; index++)
        {
            var browserFile = _previewFiles[index];
            if (!IsAllowedPreview(browserFile.ContentType))
                continue;

            var savedMedia = await SaveBrowserFileAsync(browserFile, "resources");
            if (savedMedia is null)
                continue;

            long? posterId = null;
            if (IsVideo(browserFile) && _posters.TryGetValue(index, out var posterData))
            {
                var poster = await SavePosterAsync(posterData);
                posterId = poster?.Id;
            }

            Context.ResourcesMedia.Add(new ResourceMedia
            {
                ResourceId = resourceId,
                FileId = savedMedia.Id,
                PosterFileId = posterId,
                Caption = Path.GetFileNameWithoutExtension(browserFile.Name),
                SortOrder = index
            });
        }
    }

    private async Task<FileResponse?> SavePosterAsync(string dataUrl)
    {
        var comma = dataUrl.IndexOf(',');
        if (comma < 0)
            return null;
        var bytes = Convert.FromBase64String(dataUrl[(comma + 1)..]);
        await using var stream = new MemoryStream(bytes);
        var formFile = new FormFile(stream, 0, stream.Length, "File", "video-poster.jpg")
        {
            Headers = new HeaderDictionary(),
            ContentType = "image/jpeg"
        };
        return await FileService.CreateAsync(formFile, BuildStoragePath("posters", ".jpg"), CancellationToken.None);
    }

    private async Task SaveAuthorsAsync(long resourceId)
    {
        foreach (var name in SplitList(_form.Authors))
        {
            var user = await UserManager.FindByNameAsync(name);
            if (user is not null)
                Context.ResourcesAuthors.Add(new ResourceAuthors { ResourceId = resourceId, UserId = user.Id });
            else
                Context.ResourcesExternalAuthors.Add(new ResourceExternalAuthor { ResourceId = resourceId, Author = name });
        }
    }

    private async Task SaveTagsAsync(long resourceId)
    {
        foreach (var name in SplitList(_form.Tags).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            var tag = await Context.Tags.FirstOrDefaultAsync(item => item.Name.ToLower() == name.ToLower());
            if (tag is null)
            {
                tag = new Tag { Name = name };
                Context.Tags.Add(tag);
                await Context.SaveChangesAsync();
            }
            Context.ResourcesTags.Add(new ResourceTags { ResourceId = resourceId, TagId = tag.Id });
        }
    }

    private static IEnumerable<string> SplitList(string? value) => (value ?? string.Empty)
        .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
        .Where(name => name.Length <= 100)
        .Distinct(StringComparer.OrdinalIgnoreCase);

    private static string BuildStoragePath(string folder, string extension) =>
        Path.Combine(folder, DateTime.UtcNow.ToString("yyyy"), DateTime.UtcNow.ToString("MM"), $"{Guid.NewGuid():N}{extension}")
            .Replace('\\', '/');

    private static bool IsVideo(IBrowserFile file) => file.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);

    private static bool IsAllowedPreview(string contentType) =>
        contentType is "image/png" or "image/jpeg" or "image/gif" or "image/webp" ||
        contentType is "video/mp4" or "video/webm" or "video/ogg";

    private static string FormatSize(long bytes) => bytes < 1024 * 1024
        ? $"{bytes / 1024d:0} KB"
        : $"{bytes / (1024d * 1024d):0.0} MB";

    private sealed class PosterCapture
    {
        public int Index { get; set; }
        public string DataUrl { get; set; } = string.Empty;
    }

    private sealed class ResourceForm
    {
        [Required, StringLength(120)] public string Name { get; set; } = string.Empty;
        [Required, StringLength(40)] public string Version { get; set; } = string.Empty;
        public long? VideogameId { get; set; }
        public long? ResourceTypeId { get; set; }
        [Required, StringLength(200)] public string Usage { get; set; } = string.Empty;
        [Required, StringLength(4000)] public string Description { get; set; } = string.Empty;
        [StringLength(1000)] public string? Tags { get; set; }
        [StringLength(1000)] public string? Authors { get; set; }
        [Required] public long? VisibilityId { get; set; }
        public bool IncludesGore { get; set; }
        public bool IncludesPolitics { get; set; }
        public bool IncludesPorn { get; set; }
        public bool IncludesSensitiveContent { get; set; }
        public bool IncludesSlurs { get; set; }
    }
}
