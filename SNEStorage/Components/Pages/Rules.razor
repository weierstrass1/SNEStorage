@page "/Rules"
@inject EditableContentService Content

<PageTitle>Rules | SNEStorage</PageTitle>

<section class="page-heading">
    <p class="eyebrow">COMMUNITY GUIDELINES</p>
    <h1>SNEStorage rules</h1>
    <p class="mu">Guidelines to help keep contributions useful and safe for everyone.</p>
</section>

<article class="w rules-page">
    <div class="editable-copy">@_rules</div>
</article>

@code {
    private string _rules = string.Empty;

    protected override async Task OnInitializedAsync() => _rules = await Content.ReadAsync("rules");
}
