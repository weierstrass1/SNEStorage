@page "/Profile"
@attribute [Authorize]
@inject SnestorageContext Context
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My profile | SNEStorage</PageTitle>

@if (_loading)
{
    <p class="mu" role="status">Loading profile…</p>
}
else if (_user is null)
{
    <section class="w errp"><p class="code">404</p><h1>Profile not found</h1><a class="btn" href="/">Back to home</a></section>
}
else
{
    <section class="page-heading">
        <p class="eyebrow">ESPACIO DE MIEMBRO</p>
        <div class="heading-row">
            <div><h1>My profile</h1><p class="mu">Your information and resources associated with your account.</p></div>
            <a class="btn y" href="/Profile/Edit">Edit my details</a>
        </div>
    </section>

    <section class="w profile-card">
        <div class="prof">
            <img src="@($"/User/Avatar/{_user.Id}")" alt="Avatar de @_user.UserName" />
            <div>
                <p class="eyebrow">MIEMBRO DE SNESTORAGE</p>
                <h2 style="color:@SafeColor(_info?.UsernameColor)">@_user.UserName</h2>
                @if (!string.IsNullOrWhiteSpace(_info?.Title)) { <p class="profile-title">@_info.Title</p> }
                <p class="mu">@_user.Email</p>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_info?.Bio))
        {
            <section class="sec"><h2>About me</h2><p class="editable-copy">@_info.Bio</p></section>
        }
        <div class="profile-facts">
            <div><span>Date of birth</span><strong>@_info?.Birthday.ToString("yyyy-MM-dd")</strong></div>
            <div><span>Time zone</span><strong>@(_info?.TimeZone?.Name ?? "No indicada")</strong></div>
            <div><span>Resources contributed</span><strong>@_resources.Count</strong></div>
        </div>
        @if (_info is not null)
        {
            var socials = SocialEntries(_info);
            @if (socials.Count > 0)
            {
                <section class="sec"><h2>Enlaces</h2><div class="soc">
                    @foreach (var social in socials)
                    {
                        <span class="chip"><strong>@social.Name:</strong> @social.Value</span>
                    }
                </div></section>
            }
        }
    </section>

    <section class="profile-resources">
        <div class="section-heading"><div><p class="eyebrow">ACCOUNT CONTRIBUTIONS</p><h2>My resources</h2></div><a href="/Resources/Create">Upload resource →</a></div>
        @if (_resources.Count == 0)
        {
            <div class="w empty-state"><p>There are no resources associated with your account yet.</p></div>
        }
        else
        {
            <div class="tw"><table>
                <thead><tr><th>Resource</th><th>Visibility</th><th>Created</th><th>Downloads</th></tr></thead>
                <tbody>
                    @foreach (var resource in _resources)
                    {
                        <tr>
                            <td><a href="@($"/Resource/{resource.Id}")">@resource.Name</a><span class="d">@resource.Version · @resource.Videogame?.Name</span></td>
                            <td>@resource.Visibility?.Name</td>
                            <td>@resource.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td>@(resource.Downloads ?? 0)</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
    </section>
}

@code {
    private ApplicationUser? _user;
    private UserInfo? _info;
    private List<Resource> _resources = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var userId = principal.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId))
            return;

        _user = await UserManager.FindByIdAsync(userId);
        _info = await Context.UserInfos.Include(info => info.TimeZone).AsNoTracking().FirstOrDefaultAsync(info => info.UserId == userId);
        _resources = await Context.Resources
            .Where(resource => resource.SubmitterUserId == userId || resource.ResourcesAuthors.Any(author => author.UserId == userId))
            .Include(resource => resource.Visibility)
            .Include(resource => resource.Videogame)
            .AsNoTracking()
            .OrderByDescending(resource => resource.CreatedAt)
            .Take(30)
            .ToListAsync();
        _loading = false;
    }

    private static string SafeColor(string? color) =>
        color is { Length: 7 } && color[0] == '#' && color[1..].All(Uri.IsHexDigit) ? color : "#E7E2FF";

    private static List<(string Name, string Value)> SocialEntries(UserInfo info) => new List<(string Name, string Value)>
    {
        ("Discord", info.Discord ?? ""), ("GitHub", info.Github ?? ""), ("YouTube", info.Youtube ?? ""),
        ("Twitch", info.Twitch ?? ""), ("Steam", info.Steam ?? ""), ("Patreon", info.Patreon ?? ""),
        ("PayPal", info.Paypal ?? ""), ("Buy Me a Coffee", info.BuyMeACoffee ?? ""), ("Twitter", info.Twitter ?? ""),
        ("Facebook", info.Facebook ?? ""), ("Instagram", info.Instagram ?? ""), ("Nintendo Network", info.NintendoNetwork ?? "")
    }.Where(item => !string.IsNullOrWhiteSpace(item.Value)).ToList();
}
