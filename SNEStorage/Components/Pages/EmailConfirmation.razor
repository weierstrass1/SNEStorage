@page "/Register/Confirmation"
@page "/Register/Confirmation/{UserId}"

<PageTitle>Email confirmation | SNEStorage</PageTitle>

<div class="confirmation-page">
    <section class="confirmation-card confirmation-card--@StateClass" aria-labelledby="confirmation-title" aria-busy="@IsChecking">
        <div class="confirmation-brand">
            <img src="/images/caja.png" alt="" width="48" height="48" />
            <span>SNEStorage</span>
        </div>
        <p class="confirmation-kicker">ACCOUNT VERIFICATION</p>

        <div class="confirmation-status-icon" aria-hidden="true">
            @if (_state == ConfirmationState.Confirmed)
            {
                <svg viewBox="0 0 32 32"><path d="m8 16 5 5 11-11" /></svg>
            }
            else if (IsChecking)
            {
                <svg viewBox="0 0 32 32"><rect x="5" y="8" width="22" height="16" rx="2" /><path d="m6 9 10 8L26 9" /></svg>
            }
            else
            {
                <svg viewBox="0 0 32 32"><path d="M16 8v10m0 5v1" /><circle cx="16" cy="16" r="13" /></svg>
            }
        </div>

        <div class="confirmation-copy" role="status" aria-live="polite" aria-atomic="true">
            <h1 id="confirmation-title">@Heading</h1>
            <p>@Message</p>
            @if (_state == ConfirmationState.Confirmed)
            {
                <p class="confirmation-redirect">Taking you to log in in 3 seconds...</p>
                <div class="confirmation-progress" aria-hidden="true"><span></span></div>
            }
        </div>

        @if (!IsChecking)
        {
            <div class="confirmation-actions">
                @if (_state == ConfirmationState.Unavailable)
                {
                    <button class="confirmation-primary action-button action-button-primary" type="button" @onclick="RetryAsync">Try again</button>
                    <NavLink class="confirmation-secondary" href="/Login">Back to log in</NavLink>
                }
                else
                {
                    <NavLink class="confirmation-primary action-button action-button-primary" href="/Login">Continue to log in <ActionArrow /></NavLink>
                }
                @if (_state is ConfirmationState.Invalid or ConfirmationState.Incomplete)
                {
                    <NavLink class="confirmation-secondary" href="/Register/CheckEmail">Request a new confirmation email</NavLink>
                }
            </div>
        }

        <p class="confirmation-footer"><NavLink href="/">← Return to SNEStorage</NavLink></p>
    </section>
</div>
