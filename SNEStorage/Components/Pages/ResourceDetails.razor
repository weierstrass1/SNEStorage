@page "/Resource/{ResourceId:long}"
@using SNEStorage.Components.Resources

<PageTitle>@ResourceName | SNEStorage</PageTitle>

@if (_loading)
{
    <section class="detail-loading" role="status" aria-live="polite">
        <h1>Loading resource…</h1>
        <p>Retrieving the resource and its releases.</p>
    </section>
}
else if (_errorStatus is { } status)
{
    <ErrorPanel StatusCode="status" ErrorBody="@_errorBody" Domain="resource" OnRetry="Reload" />
}
else if (_resource is { } resource)
{
    <article class="resource-detail">
        <nav class="detail-breadcrumb" aria-label="Breadcrumb">
            <NavLink href="/">Home</NavLink><span aria-hidden="true">/</span>
            <NavLink href="/Resources">Resources</NavLink><span aria-hidden="true">/</span>
            <span aria-current="page">@ResourceName</span>
        </nav>

        <header class="detail-header">
            <div class="detail-title-row">
                <div class="detail-title-and-rating">
                    <h1><span class="detail-resource-name @(HasQualitySeal ? "has-quality-seal" : "")">@ResourceName</span>
                        @if (HasQualitySeal)
                        {
                            <ResourceQualitySeal Size="72" Title="The latest release meets SNEStorage's quality standards." />
                        }
                    </h1>
                    <ResourceRating @key="resource.Id" ResourceId="resource.Id" Score="resource.Score" IsAuthenticated="_isAuthenticated" CurrentUserId="@_currentUserId" IsOwnResource="CanManage" IsPrivate="@(resource.VisibilityId == 3)" Saving="_savingRating" Message="@_ratingMessage" OnRate="RateAsync" />
                </div>
                @if (CanManage)
                {
                    <NavLink class="detail-action" href="@($"/Resource/{ResourceId}/Edit")">Edit resource</NavLink>
                }
            </div>
            @if (resource.AlreadyModerated)
            {
                <p class="detail-rules-approved">This resource complies with SNEStorage's site rules.</p>
            }
        </header>

        <section class="detail-authors" aria-labelledby="authors-heading">
            <h2 id="authors-heading">Authors</h2>
            @if (resource.ResourcesAuthors.Count == 0 && resource.ResourceExternalAuthors.Count == 0)
            {
                <p class="detail-muted">Author information is not available.</p>
            }
            <ul class="detail-credits">
                @foreach (var author in resource.ResourcesAuthors)
                {
                    <li>
                        @if (AuthorProfileUrl(author) is { } profileUrl)
                        {
                            <NavLink class="detail-author-link" href="@profileUrl" style="@($"color: {AuthorColor(author)}")">@AuthorName(author)</NavLink>
                        }
                        else
                        {
                            <span style="@($"color: {AuthorColor(author)}")">@AuthorName(author)</span>
                        }
                    </li>
                }
                @foreach (var author in resource.ResourceExternalAuthors)
                {
                    <li><span>@author.Author</span><small>External author</small></li>
                }
            </ul>
        </section>

        <div class="detail-tabs" role="tablist" aria-label="Resource sections">
            <button type="button" id="resource-overview-tab" role="tab" aria-selected="@(!_showVersions)" aria-controls="resource-overview-panel" tabindex="@(_showVersions ? -1 : 0)" @onclick="ShowOverview" @onkeydown="HandleTabKeyDown">Overview</button>
            <button type="button" id="resource-versions-tab" role="tab" aria-selected="@_showVersions" aria-controls="resource-versions-panel" tabindex="@(_showVersions ? 0 : -1)" @onclick="ShowVersions" @onkeydown="HandleTabKeyDown">Version history <span>@Versions.Count</span></button>
        </div>

        <div id="resource-overview-panel" role="tabpanel" aria-labelledby="resource-overview-tab" hidden="@_showVersions" tabindex="0" class="detail-tab-panel">
            <section class="detail-panel detail-overview" aria-labelledby="about-heading">
                <h2 id="about-heading" class="detail-sr-only">About this resource</h2>
                <dl class="detail-metadata">
                    <div><dt>Video game</dt><dd>@(resource.Videogame?.Name ?? "Not specified")</dd></div>
                    <div>
                        <dt>Categories</dt>
                        <dd class="detail-badges">
                            @if (Categories.Count == 0)
                            {
                                <span class="detail-muted">Not specified</span>
                            }
                            @foreach (var category in Categories)
                            {
                                <span class="detail-badge" @key="category.Id">@category.Name</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>Resource types</dt>
                        <dd class="detail-badges">
                            @if (resource.ResourceResourceTypes.Count == 0)
                            {
                                <span class="detail-muted">Not specified</span>
                            }
                            @foreach (var type in resource.ResourceResourceTypes)
                            {
                                <span class="detail-badge">@(type.ResourceType?.Name ?? "Resource type")</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>Tags</dt>
                        <dd class="detail-tags">
                            @if (resource.ResourceTags.Count == 0)
                            {
                                <span class="detail-muted">No tags</span>
                            }
                            @foreach (var tag in resource.ResourceTags)
                            {
                                @if (!string.IsNullOrWhiteSpace(tag.Tag?.Name))
                                {
                                    <span>#@tag.Tag.Name</span>
                                }
                            }
                        </dd>
                    </div>
                    @if (ResourceFileLinks.External(resource.RepositoryURL) is { } repositoryUrl)
                    {
                        <div><dt>Repository</dt><dd><a class="detail-repository-link" href="@repositoryUrl" target="_blank" rel="noopener noreferrer">View source repository ↗</a></dd></div>
                    }
                </dl>
                <h3>Description</h3>
                <p class="detail-description">@(string.IsNullOrWhiteSpace(resource.Description) ? "No description has been provided." : resource.Description)</p>
                <section class="detail-download-section" aria-label="Download latest version">
                    <div>
                        <h2>Latest version</h2>
                        @if (LatestVersion is { } latest)
                        {
                            <p><strong>@VersionLabel(latest)</strong> · @FormatDate(latest.CreatedAt)</p>
                            <ResourceVersionStatus Version="latest" />
                        }
                        <span>@Downloads.ToString("N0", DisplayCulture) total downloads</span>
                    </div>
                    @if (LatestDownload is { } download)
                    {
                        <a class="detail-download" href="@download" data-enhance-nav="false">Download <span aria-hidden="true">↓</span></a>
                    }
                    else
                    {
                        <span class="detail-muted">No download available</span>
                    }
                </section>
            </section>

            @if (ContentWarnings.Count > 0)
            {
                <aside class="detail-content-warning" aria-label="Content warnings">
                    <strong><span aria-hidden="true">⚠</span> Content warnings</strong>
                    <p>This resource contains content that may not be suitable for all viewers.</p>
                    <div class="detail-badges">
                        @foreach (var warning in ContentWarnings)
                        {
                            <span class="detail-warning-badge">@warning</span>
                        }
                    </div>
                </aside>
            }

            <section class="detail-panel" aria-labelledby="dependencies-heading">
                <h2 id="dependencies-heading">Dependencies</h2>
                @if (resource.ResourceDependencies.Count == 0 && resource.ResourceExternalDependencies.Count == 0)
                {
                    <p class="detail-muted">No dependencies have been listed.</p>
                }
                else
                {
                    <ul class="detail-dependencies">
                        @foreach (var dependency in resource.ResourceDependencies)
                        {
                            <li><span class="detail-list-label">SNEStorage</span><NavLink href="@($"/Resource/{dependency.DependencyResourceId}")">@(dependency.DependencyResource?.Name ?? "View dependency") <span aria-hidden="true">→</span></NavLink></li>
                        }
                        @foreach (var dependency in resource.ResourceExternalDependencies)
                        {
                            <li>
                                <span class="detail-list-label">External</span>
                                @if (ResourceFileLinks.External(dependency.DependencyURL) is { } externalUrl)
                                {
                                    <a href="@externalUrl" target="_blank" rel="noopener noreferrer">@dependency.DependencyName <span aria-hidden="true">↗</span></a>
                                }
                                else
                                {
                                    <span>@dependency.DependencyName</span>
                                }
                                <div class="detail-mirrors">
                                    @foreach (var mirror in MirrorLinks(dependency))
                                    {
                                        <a href="@mirror.Url" target="_blank" rel="noopener noreferrer">@mirror.Name ↗</a>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="detail-previews" aria-labelledby="previews-heading">
                <h2 id="previews-heading">Previews</h2>
                <ResourceMediaCarousel @key="resource.Id" ResourceId="resource.Id" ResourceName="@ResourceName" Previews="@Previews" />
            </section>

            @if (resource.Dependents.Count > 0)
            {
                <section class="detail-panel" aria-labelledby="dependents-heading">
                    <h2 id="dependents-heading">Used by</h2>
                    <ul class="detail-dependencies">
                        @foreach (var dependent in resource.Dependents)
                        {
                            <li><NavLink href="@($"/Resource/{dependent.ResourceId}")">@(dependent.Resource?.Name ?? "View resource") →</NavLink></li>
                        }
                    </ul>
                </section>
            }

            <ResourceCommentsPanel @key="resource.Id" ResourceId="resource.Id" IsAuthenticated="_isAuthenticated"
                                   CurrentUserId="@_currentUserId" CanModerate="_canModerateComments"
                                   Saving="_savingComment" Message="@_commentMessage"
                                   SubmissionRevision="_commentSubmissionRevision" PublishedComment="_publishedComment" OnPost="PostCommentAsync" />
            <p class="detail-footer-meta">
                Published <time datetime="@resource.CreatedAt.ToString("O")">@FormatDate(resource.CreatedAt)</time>
                @if (resource.UpdatedAt is { } updatedAt) { <span>· Updated <time datetime="@updatedAt.ToString("O")">@FormatDate(updatedAt)</time></span> }
                @if (!string.IsNullOrWhiteSpace(resource.Visibility?.Name)) { <span>· @resource.Visibility.Name</span> }
            </p>
        </div>

        <div id="resource-versions-panel" role="tabpanel" aria-labelledby="resource-versions-tab" hidden="@(!_showVersions)" tabindex="0" class="detail-tab-panel">
            @if (CanManage)
            {
                <div class="detail-version-actions"><p class="detail-muted">Manage the releases of your resource.</p><NavLink class="detail-action" href="@($"/Resource/{ResourceId}/Versions/Create")">+ Add version</NavLink></div>
            }
            <ResourceReleaseList ResourceId="resource.Id" Versions="@Versions" CanManage="CanManage" />
        </div>
        <NavLink class="detail-library-link" href="/Resources">← Back to resources</NavLink>
    </article>
}
