<article class="news-card @(Compact ? "is-compact" : null) @(FullArticle ? "is-full" : null)" id="@($"news-{Item.Id}")" aria-labelledby="@($"news-heading-{Item.Id}")">
    <div class="news-meta">
        <span class="author-avatar-frame" aria-hidden="true">
            <img class="author-avatar" src="@AvatarUrl" alt="" width="32" height="32" loading="lazy" @onerror="ShowFallbackAvatar" />
        </span>
        <a class="author-name" href="@ProfileUrl" style="color:@UsernameColor">@Item.UserSummary.Username</a>
        <time datetime="@Item.CreatedAt.ToString("O")">@PublicationDate</time>
        @if (CanEdit)
        {
            <button class="edit-news" type="button" @onclick="StartEditing" aria-expanded="@_editing" aria-controls="@($"news-editor-{Item.Id}")" aria-label="@($"Edit news: {Item.Title}")" disabled="@_editing">Edit news</button>
        }
    </div>
    @if (FullArticle)
    {
        <h1 id="@($"news-heading-{Item.Id}")">@Item.Title</h1>
    }
    else
    {
        <h3 id="@($"news-heading-{Item.Id}")"><a class="news-title-link" href="@ArticleUrl">@Item.Title</a></h3>
    }
    @if (_editing && CanEdit)
    {
        <div id="@($"news-editor-{Item.Id}")">
            <NewsEditForm Item="Item" OnSaved="NewsSaved" OnCancel="CancelEditing" />
        </div>
    }
    else
    {
        <div class="news-text"><MarkdownText Text="@Item.Text" Compact="Compact" MaxLines="ExcerptLines" /></div>
        @if (_saved) { <p class="news-saved" role="status">Changes saved.</p> }
    }
    @if (!FullArticle && !_editing)
    {
        <a class="read-news" href="@ArticleUrl" aria-label="@($"Read full news: {Item.Title}")">Read full update <span aria-hidden="true">→</span></a>
    }
    <NewsReactions @key="Item.Id" Item="Item" />
</article>
