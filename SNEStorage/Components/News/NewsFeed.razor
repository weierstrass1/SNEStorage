<div class="news-feed" aria-busy="@(_initializing || _loading)">
    <CascadingValue Name="NewsFeedContext" Value="_reactionsContext">
        @foreach (var item in _items)
        {
            <NewsCard @key="item.Id" Item="item" Compact="Compact" CanEdit="CanEdit" />
        }
    </CascadingValue>
    @if (_initializing || _loading)
    {
        <BoxLoader Label="@(_items.Count == 0 ? "Loading news…" : "Loading more news…")" Compact="@(_items.Count > 0)" />
    }
    else if (_error is not null)
    {
        <div class="news-status" role="alert">
            <p>@_error</p>
            <button type="button" @onclick="RetryAsync">Try again</button>
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="news-status news-empty">
            <EmptyBoxIllustration />
            <h3>No news yet</h3>
            <p>Check back soon for updates!</p>
        </div>
    }
    else if (Infinite)
    {
        @if (_endReached)
        {
            <p class="news-end">You're all caught up.</p>
        }
        else
        {
            <button class="load-more" type="button" @onclick="LoadMoreAsync">Load more news</button>
        }
    }
    <div class="news-sentinel" @ref="_sentinel" aria-hidden="true"></div>
</div>
