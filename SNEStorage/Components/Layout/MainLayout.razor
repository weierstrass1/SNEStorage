@inherits LayoutComponentBase

<div class="site-shell">
    <header class="nav">
        <a class="logo" href="/" aria-label="SNEStorage, home">
            <img src="images/logo-box.png" alt="" />
            <span>SNEStorage</span>
        </a>

        <nav aria-label="Main navigation">
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="/Resource">Resources</NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/Rules">Rules</NavLink>
                    <NavLink href="/Profile">My profile</NavLink>
                    @if (Access.CanUpload(context.User))
                    {
                        <NavLink href="/Resources/Create">Upload resource</NavLink>
                    }
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/Rules">Rules</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>

        <AuthorizeView>
            <Authorized>
                <div class="user">
                    <a href="/Profile">@context.User.Identity?.Name</a>
                    <form method="post" action="/auth/logout">
                        <AntiforgeryToken />
                        <button class="btn sm" type="submit">Sign out</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="user">
                    <a href="/Login">Sign in</a>
                    <a class="btn sm" href="/Register">Create account</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main>
        @Body
    </main>

    <footer>
        <div class="disc">@_disclaimer</div>
        <nav aria-label="Footer links">
            <a href="/Rules">Rules</a>
            <a href="/Resource">Resources</a>
            <a href="/">Home</a>
        </nav>
        <p class="footer-caption">SNEStorage · Community archive for SNES</p>
    </footer>
</div>

@code {
    private string _disclaimer = "SNEStorage is a community archive. Each resource belongs to its authors.";

    [Inject] private EditableContentService Content { get; set; } = default!;
    [Inject] private ResourceAccessService Access { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _disclaimer = await Content.ReadAsync("disclaimer");
    }
}
