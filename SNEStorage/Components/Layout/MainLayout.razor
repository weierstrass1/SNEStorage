@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <div class="header-inner container">
            <a class="header-brand" href="/" aria-label="SNEStorage home">
                <img src="images/caja.png" alt="" width="44" height="44" />
                <span>SNEStorage</span>
            </a>
            <div class="account-links">
                <VerifiedAccountContent StaffOnly="true">
                    <NavLink class="moderation-link" href="/Moderation" title="Moderation panel" aria-label="Moderation panel">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z" /><path d="m8 12 3 3 5-6" /></svg>
                        <span>Moderation</span>
                    </NavLink>
                </VerifiedAccountContent>
                <AccountNavigation />
            </div>
        </div>
    </header>

    <SideNavigation />

    <div class="page-region">
        <div class="mobile-navigation container">
            <button class="navigation-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#site-sidebar" aria-controls="site-sidebar" aria-label="Open navigation">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                Menu
            </button>
        </div>

        <main class="container app-content">
            @if (CurrentPageRoute is { } routeData)
            {
                <PageAccessGuard RouteData="routeData">
                    @Body
                    @if (ShouldFocusPageTitle)
                    {
                        <FocusOnNavigate RouteData="routeData" Selector="h1" />
                    }
                </PageAccessGuard>
            }
            else
            {
                @Body
            }
        </main>

        <footer class="site-footer">
            <div class="footer-main container">
                <div class="footer-brand">
                    <div class="footer-brand-name">
                        <img src="images/caja.png" alt="" />
                        <span>SNEStorage</span>
                    </div>
                    <p>A home for SNES hacks, homebrew, and creator tools.</p>
                </div>

                <nav class="footer-links" aria-label="Footer navigation">
                    <NavLink href="/Rules">Site rules</NavLink>
                    <NavLink href="/Privacy">Privacy</NavLink>
                    <NavLink href="/About">About</NavLink>
                </nav>
            </div>

            <div class="footer-bottom container">
                <p class="footer-disclaimer"><span>COMMUNITY DISCLAIMER</span> SNEStorage is an independent fan community project and is not affiliated with or endorsed by Nintendo. Nintendo and Super Nintendo are trademarks of Nintendo.</p>
                <p class="footer-credit">BUILT FOR THE SNES HACKING COMMUNITY</p>
            </div>
        </footer>
    </div>
    <SpcPlaylistHost />
</div>

<CaptchaPrompt />
<ReportPrompt />
<aside id="vote-background-notice" class="vote-background-notice" hidden role="alert">
    <p data-vote-notice-message></p>
    <a data-vote-notice-link>Review vote</a>
    <button type="button" data-vote-notice-dismiss aria-label="Dismiss notification">Dismiss</button>
</aside>
