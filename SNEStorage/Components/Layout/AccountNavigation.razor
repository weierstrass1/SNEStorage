@if (_isAuthenticated is null)
{
    @if (_lastUnavailableStatus.HasValue)
    {
        <div class="account-unavailable" role="status">
            <span>@(_lastUnavailableStatus == 404 ? "Account profile unavailable" : "Account unavailable")</span>
            <button type="button" class="account-retry" @onclick="RefreshAsync">Retry</button>
            <NavLink class="navigation-button action-button action-button-compact" href="@LoginUrl">Log in</NavLink>
        </div>
    }
    else
    {
        <div class="account-placeholder" role="status">
            <span>Checking account…</span>
        </div>
    }
}
else if (_isAuthenticated == true)
{
    <AccountMenu Username="@_username" UsernameColor="@_usernameColor" AvatarUrl="@_avatarUrl" />
}
else
{
    <NavLink class="navigation-button action-button action-button-compact" href="@LoginUrl">Log in</NavLink>
    <NavLink class="navigation-button navigation-button-primary action-button action-button-primary action-button-compact" href="/Register">Sign up</NavLink>
}
