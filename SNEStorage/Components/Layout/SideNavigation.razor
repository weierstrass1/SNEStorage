                <span class="quality-navigation-label navigation-label">Seal of Quality</span>
            </NavLink>
            <NavLink class="navigation-button" href="/About" aria-label="About" title="About">
                <svg class="navigation-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7v1" /></svg>
                <span class="navigation-label">About</span>
            </NavLink>
            <NavLink class="navigation-button" href="/Donations" aria-label="Donations" title="Donations">
                <svg class="navigation-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21 3.5 12.5a5.5 5.5 0 0 1 8.5-7 5.5 5.5 0 0 1 8.5 7L12 21Z" /></svg>
                <span class="navigation-label">Donations</span>
            </NavLink>
            <NavLink class="navigation-button" href="/Privacy" aria-label="Privacy" title="Privacy">
                <svg class="navigation-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3ZM9 12l2 2 4-4" /></svg>
                <span class="navigation-label">Privacy</span>
            </NavLink>
        </nav>
    </div>
</aside>
