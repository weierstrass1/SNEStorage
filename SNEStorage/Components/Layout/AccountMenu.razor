<div class="dropdown account-menu">
    <button class="account-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
            aria-label="@($"Account options for {Username}")">
        <img class="account-avatar" src="@DisplayAvatarUrl" alt="" width="36" height="36" @onerror="ShowFallbackAvatar" />
        <span class="account-name" title="@Username" style="color: @DisplayUsernameColor">@Username</span>
        <svg class="account-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
    </button>

    <ul class="dropdown-menu dropdown-menu-end account-dropdown" aria-label="Account options">
        <li>
            <a class="dropdown-item account-menu-item" href="/Profile">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></svg>
                View profile
            </a>
        </li>
        <li><hr class="dropdown-divider account-menu-divider" /></li>
        <li>
            <form action="/api/login/logout" method="post" data-enhance="false">
                <AntiforgeryToken />
                <button class="dropdown-item account-menu-item account-logout" type="submit">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H4v16h5m5-12 4 4-4 4M8 12h12" /></svg>
                    Log out
                </button>
            </form>
        </li>
    </ul>
</div>
