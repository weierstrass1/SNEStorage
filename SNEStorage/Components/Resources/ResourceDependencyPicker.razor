<div class="dependency-picker">
    <label for="resource-dependency-search">SNEStorage dependencies</label>
    <p class="dependency-help">Search for a resource required to use this submission.</p>
    @if (Values.Length > 0)
    {
        <ul class="dependency-list" aria-label="Selected resource dependencies">
            @foreach (var id in Values)
            {
                <li @key="id">
                    <input type="hidden" name="DependencyIDs" value="@id" />
                    <span>@_names.GetValueOrDefault(id, "Selected resource")</span>
                    <button type="button" aria-label="Remove dependency @_names.GetValueOrDefault(id, "Selected resource")" @onclick="() => RemoveAsync(id)">×</button>
                </li>
            }
        </ul>
    }
    <input id="resource-dependency-search" type="search" value="@_search" @oninput="SearchChangedAsync" disabled="@(!_ready)" placeholder="Type at least 2 characters…" autocomplete="off" aria-describedby="resource-dependency-status" data-resource-author-input />
    <div id="resource-dependency-status" role="status" aria-live="polite">
        @if (_error is not null)
        {
            <p class="dependency-error">@_error</p>
            @if (_ready) { <button type="button" class="dependency-retry" @onclick="RetryAsync">Try again</button> }
        }
        else if (_loading) { <p class="dependency-help">Searching resources…</p> }
        else if (_search.Trim().Length < 2) { <p class="dependency-help">Type at least 2 characters to search.</p> }
        else if (!Suggestions.Any()) { <p class="dependency-help">No other matching resources. Try another name.</p> }
    </div>
    @if (!_loading && _error is null && Suggestions.Any())
    {
        <div class="dependency-results" role="group" aria-label="Resource dependency choices">
            @foreach (var item in Suggestions)
            {
                <button @key="item.Id" type="button" @onclick="() => AddAsync(item)"><span>@item.Name</span><span aria-hidden="true">+</span></button>
            }
        </div>
        @if (_matches.Count == MaxResults) { <p class="dependency-help">Up to @MaxResults matches are shown. Refine your search if needed.</p> }
    }
</div>
