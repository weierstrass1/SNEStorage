@using SNEStorage.Components.Rules
@inherits StaticDocumentPage<SiteRulesDocument>

<details class="submission-rules">
    <summary><span class="submission-rules-title">Submission guidelines</span><span class="submission-rules-hint">Read before uploading</span><span class="submission-rules-chevron" aria-hidden="true"></span></summary>
    <div class="submission-rules-body">
        @if (_loading)
        {
            <p class="submission-rules-status" role="status">Loading the submission guidelines…</p>
        }
        else if (_error is not null)
        {
            <p class="submission-rules-status" role="status">@_error</p>
            <button type="button" class="submission-rules-retry" @onclick="LoadAsync">Try again</button>
        }
        else
        {
            <div class="submission-guideline-sections">
                @foreach (var section in _sections)
                {
                    <section class="submission-guideline-section">
                        <h2>@section.Title</h2>
                        <ul>
                            @foreach (var rule in section.Rules.Concat(section.Groups.SelectMany(group => group.Rules)))
                            {
                                <li class="@(rule.Id == "rom-uploads" ? "submission-rom-rule" : null)"><strong>@rule.Title</strong><span>@rule.Text</span></li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }
        <p class="full-rules-link"><a href="/Rules" target="_blank" rel="noopener noreferrer" aria-label="Read all site rules (opens in a new tab)">Read all site rules <ActionArrow /></a><span>Opens in a new tab so you can keep your submission.</span></p>
    </div>
</details>
