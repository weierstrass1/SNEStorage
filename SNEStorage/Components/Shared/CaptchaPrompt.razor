<dialog id="captcha-dialog" class="captcha-dialog" aria-labelledby="captcha-heading" aria-describedby="captcha-description">
    <div class="captcha-content">
        <span class="captcha-eyebrow">SNESTORAGE SECURITY</span>
        <h2 id="captcha-heading">Quick verification</h2>
        <p id="captcha-description">Complete this check to continue. Your form stays exactly as you left it.</p>
        <div data-captcha-widget class="captcha-widget"></div>
        <p data-captcha-status class="captcha-status" role="status" aria-live="polite">Preparing verification…</p>
        <div class="captcha-actions">
            <button type="button" data-captcha-retry hidden>Try again</button>
            <button type="button" data-captcha-cancel autofocus>Cancel</button>
        </div>
    </div>
</dialog>
