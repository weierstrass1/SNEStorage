<div class="password-page">
    <section class="password-card" aria-labelledby="password-heading" aria-busy="@_saving">
        <header class="password-heading">
            <img src="/images/caja.png" width="54" height="54" alt="" />
            <p class="password-kicker">ACCOUNT SECURITY</p>
            <h1 id="password-heading">@Heading</h1>
            <p>@Introduction</p>
        </header>

        @if (_succeeded)
        {
            <div class="password-success" role="status">
                <span class="password-success-icon" aria-hidden="true">✓</span>
                <h2>@(RequestEmail ? "Check your inbox" : "Password updated")</h2>
                <p>@(RequestEmail
                    ? "If an account matches this email, we’ll send a password reset link. Check your spam folder too."
                    : "Your new password has been saved. You can now use it to log in.")</p>
            </div>
            @if (RequestEmail)
            {
                <p class="password-note">The email may take a few minutes to arrive.</p>
                <button type="button" class="password-secondary action-button" @onclick="TryAnotherEmail">Try another email</button>
                <a class="password-back" href="/Login">Back to Login</a>
            }
            else
            {
                <a class="password-primary action-button action-button-primary" href="/Login?passwordChanged=1" data-enhance-nav="false">Continue to Login <ActionArrow /></a>
            }
        }
        else if (!HasCompleteLink)
        {
            <div class="password-error" role="alert">
                <h2>This link is incomplete</h2>
                <p>Open the complete password reset link from your email, or request another one.</p>
            </div>
            <NavLink class="password-primary action-button action-button-primary" href="/Account/ForgotPassword">Request a new link</NavLink>
        }
        else
        {
            @if (_error is not null)
            {
                <div class="password-error" role="alert">
                    <h2>@_error.Title</h2>
                    <p>@_error.Message</p>
                    @if (_error.SignIn && RequestEmail)
                    {
                        <a href="/Login?returnUrl=%2FAccount%2FForgotPassword">Log in to continue</a>
                    }
                    @if (_error.Code == "InvalidToken" || _error.Code == "UserNotFound")
                    {
                        <NavLink href="/Account/ForgotPassword">Request a new link</NavLink>
                    }
                </div>
            }

            <EditForm Model="FormModel" OnValidSubmit="SubmitAsync" FormName="password-reset" id="@_formId" class="password-form">
                <DataAnnotationsValidator />
                <fieldset disabled="@_saving">
                    @if (RequestEmail)
                    {
                        <div class="password-field">
                            <label for="reset-email">Account email</label>
                            <InputText id="reset-email" name="Email" type="email" maxlength="@TextLimits.EMAIL" @bind-Value="_emailForm.Email" autocomplete="email" placeholder="you@example.com" required />
                            <ValidationMessage For="@(() => _emailForm.Email)" />
                        </div>
                        <p class="password-note">We’ll send a secure link so you can choose a new password. Your password stays the same until you complete that step.</p>
                    }
                    else
                    {
                        <input type="hidden" name="UserId" value="@UserId" />
                        <input type="hidden" name="Token" value="@Token" />
                        <div class="password-field">
                            <label for="reset-new-password">New password</label>
                            <InputText id="reset-new-password" name="NewPassword" type="@PasswordInputType" maxlength="@TextLimits.PASSWORD" @bind-Value="_passwordForm.NewPassword" autocomplete="new-password" required />
                            <ValidationMessage For="@(() => _passwordForm.NewPassword)" />
                        </div>
                        <div class="password-field">
                            <label for="reset-confirm-password">Confirm new password</label>
                            <InputText id="reset-confirm-password" name="ConfirmPassword" type="@PasswordInputType" maxlength="@TextLimits.PASSWORD" @bind-Value="_passwordForm.ConfirmPassword" autocomplete="new-password" required />
                            <ValidationMessage For="@(() => _passwordForm.ConfirmPassword)" />
                        </div>
                        <button type="button" class="password-reveal" aria-pressed="@_showPasswords" @onclick="TogglePasswords">@(_showPasswords ? "Hide passwords" : "Show passwords")</button>
                        <p class="password-note">Choose a password you don’t use on another website.</p>
                    }
                </fieldset>
                <button class="password-primary action-button action-button-primary" type="submit" disabled="@_saving">
                    @(_saving ? "Please wait…" : RequestEmail ? "Send reset link" : "Save new password")
                    @if (!_saving) { <ActionArrow /> }
                </button>
                @if (_saving)
                {
                    <p class="password-note" role="status">@(RequestEmail ? "Completing verification and requesting your email…" : "Saving your new password…")</p>
                }
            </EditForm>
            <NavLink class="password-back" href="/Login">Back to Login</NavLink>
        }
    </section>
</div>
