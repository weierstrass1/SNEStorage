@if (_requirement is null)
{
    @ChildContent
}
else
{
    @if (_access is not null)
    {
        @* Keep the verified page mounted so a rejected recheck cannot erase files or drafts.
           Hidden/inert prevents interaction until the same account regains access. *@
        <div class="access-content" hidden="@_accessBlocked" inert="@(_accessBlocked ? string.Empty : null)">
            <CascadingValue Name="VerifiedPageAccount" Value="_access" IsFixed="true" @key="@($"{_pageKey}:{_access.Profile.UserId}")">
                @ChildContent
            </CascadingValue>
        </div>
    }
    @if (_errorStatus is { } status)
    {
        <PageTitle>Access | SNEStorage</PageTitle>
        <ErrorPanel StatusCode="status" ErrorBody="@_errorBody" Domain="@_errorDomain" OnRetry="Retry" />
        @if (status == 403)
        {
            <div class="access-sign-in"><NavLink href="@LoginUrl">Log in with an account that has access</NavLink></div>
        }
    }
    else if (_access is null || _accessBlocked)
    {
        <section class="access-loading" role="status" aria-live="polite">
            <PageTitle>Loading | SNEStorage</PageTitle>
            <h1>Checking access…</h1>
            <p>Please wait while we verify your account.</p>
        </section>
    }
}
