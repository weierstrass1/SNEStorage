@page
@using SNEStorage.Pages.Register
@using Microsoft.AspNetCore.Components.Authorization
@model RegisterModel
@{
    Layout = "_Layout";
}

<AuthorizeView>
    <Authorized>
        <div class="text-center">
            <h1 class="display-4">You are already logged in</h1>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container">
            <div class="row">
                <h2 class="col-12 padding-mid text-center text-primary">Register</h2>
            </div>
            <div class="row">
                <div class="col-2"></div>
                <form class="col-8" asp-controller="Register" asp-action="Register" method="post">
                    <div class="row padding-mid form-group mt-1">
                        <div class="col-1"></div>
                        @Html.LabelFor(m => m.DTO.User, new { @class = "col-4 padding-side-mid padding-v-quarter text-end text-primary" })
                        @Html.TextBoxFor(m => m.DTO.User, new { @class = "col-6 padding-side-mid", placeholder = "Enter your Username" })
                        <div class="col-1"></div>
                        <span asp-validation-for="User" class="col-12 padding-side-mid padding-v-quarter text-center text-danger" />
                    </div>
                    <div class="row padding-mid form-group mt-1">
                        <div class="col-1"></div>
                        @Html.LabelFor(m => m.DTO.UsernameColor, new { @class = "col-4 padding-side-mid padding-v-quarter text-end text-primary" })
                        @Html.TextBoxFor(m => m.DTO.UsernameColor, new { @class = "col-6 padding-side-mid", value = "#FFFFFF", placeholder = "Enter a Color", Type = "color" })
                        <div class="col-1"></div>
                        <span asp-validation-for="UsernameColor" class="col-12 padding-side-mid padding-v-quarter text-center text-danger" />
                    </div>
                    <div class="row padding-mid form-group mt-1">
                        <div class="col-1"></div>
                        @Html.LabelFor(m => m.DTO.Email, new { @class = "col-4 padding-side-mid padding-v-quarter text-end text-primary" })
                        @Html.TextBoxFor(m => m.DTO.Email, new { @class = "col-6 padding-side-mid", placeholder = "Enter your Email" })
                        <div class="col-1"></div>
                        <span asp-validation-for="Email" class="col-12 padding-side-mid padding-v-quarter text-center text-danger" />
                    </div>
                    <div class="row padding-mid form-group mt-1">
                        <div class="col-1"></div>
                        @Html.LabelFor(m => m.DTO.Password, new { @class = "col-4 padding-side-mid padding-v-quarter text-end text-primary" })
                        @Html.PasswordFor(m => m.DTO.Password, new { @class = "col-6 padding-side-mid", placeholder = "Enter your Password" })
                        <div class="col-1"></div>
                        <span asp-validation-for="Password" class="col-12 padding-side-mid padding-v-quarter text-center text-danger" />
                    </div>
                    <div class="row padding-mid form-group mt-1">
                        <div class="col-1"></div>
                        @Html.LabelFor(m => m.DTO.PasswordRepeat, new { @class = "col-4 padding-side-mid padding-v-quarter text-end text-primary" })
                        @Html.PasswordFor(m => m.DTO.PasswordRepeat, new { @class = "col-6 padding-side-mid", placeholder = "Enter your Password Again" })
                        <div class="col-1"></div>
                        <span asp-validation-for="PasswordRepeat" class="col-12 padding-side-mid padding-v-quarter text-center text-danger" />
                    </div>
                    <div class="row padding-mid form-group mt-1">
                        <div class="col-1"></div>
                        @Html.LabelFor(m => m.DTO.Birthday, new { @class = "col-4 padding-side-mid padding-v-quarter text-end text-primary" })
                        @Html.TextBoxFor(m => m.DTO.Birthday, new { @class = "col-6 padding-side-mid", type = "date" })
                        <div class="col-1"></div>
                        <span asp-validation-for="Birthday" class="col-12 padding-side-mid padding-v-quarter text-center text-danger" />
                    </div>
                    <div class="row padding-mid form-group mt-1">
                        <div class="col-1"></div>
                        @Html.LabelFor(m => m.DTO.TimeZoneId, new { @class = "col-4 padding-side-mid padding-v-quarter text-end text-primary" })
                        <select asp-for="TimeZoneId" class="col-6 padding-side-mid" asp-items="ViewBag.TimeZones">
                        </select>
                        <div class="col-1"></div>
                    </div>
                    <div class="row padding-mid form-group mt-1">
                        <div class="col-1"></div>
                        @Html.LabelFor(m => m.DTO.EmailVisibilityId, new { @class = "col-4 padding-side-mid padding-v-quarter text-end text-primary" })
                        <select asp-for="EmailVisibilityId" class="col-6 padding-side-mid" asp-items="ViewBag.Visibilities">
                        </select>
                        <div class="col-1"></div>
                    </div>
                    <div class="row padding-mid form-group mt-1">
                        <div class="col-2"></div>
                        <input class="col-8 padding-side-mid padding-v-quarter text-end text-primary" type="file" asp-for="Avatar" accept=".png,.jpg,.jpeg" />
                        <div class="col-2"></div>
                    </div>
                    <div class="row padding-mid form-group mt-1">
                        <div class="col-5"></div>
                        <button type="submit" class="col-2 padding-quarter btn btn-primary">Register</button>
                        <div class="col-5"></div>
                    </div>
                </form>
                <div class="col-2"></div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>